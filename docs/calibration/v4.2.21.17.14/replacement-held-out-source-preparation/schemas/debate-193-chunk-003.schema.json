{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester-v422112-simplified-score-blind-chunk-discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolId",
    "debateNumber",
    "debateId",
    "chunkId",
    "coreStartEvent",
    "coreEndEvent",
    "contextStartEvent",
    "contextEndEvent",
    "reviewerRole",
    "assessmentModel",
    "calibrationOnly",
    "completeCoreReviewed",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "4.2.21.12-score-blind-chunk-discovery"
    },
    "protocolId": {
      "type": "string",
      "const": "v4.2.21.12-simplified-partition-discovery"
    },
    "debateNumber": {
      "type": "string",
      "const": "193"
    },
    "debateId": {
      "type": "string",
      "const": "crossan-licona-historical-jesus-2018"
    },
    "chunkId": {
      "type": "string",
      "const": "chunk-003"
    },
    "coreStartEvent": {
      "type": "integer",
      "const": 1075
    },
    "coreEndEvent": {
      "type": "integer",
      "const": 1132
    },
    "contextStartEvent": {
      "type": "integer",
      "const": 1035
    },
    "contextEndEvent": {
      "type": "integer",
      "const": 1132
    },
    "reviewerRole": {
      "type": "string",
      "const": "score-blind-source-discovery"
    },
    "assessmentModel": {
      "type": "string",
      "const": "5.6 Sol"
    },
    "calibrationOnly": {
      "type": "boolean",
      "const": true
    },
    "completeCoreReviewed": {
      "type": "boolean",
      "const": true
    },
    "candidates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "side",
          "speaker",
          "proposition",
          "sourceSpan",
          "attributionConfidence",
          "attributionBasis",
          "loadBearingLevel",
          "loadBearingReason",
          "responseIntent",
          "contextSummary",
          "candidateConfidence"
        ],
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "type": "string",
            "enum": [
              "pro",
              "con"
            ]
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "proposition": {
            "type": "string",
            "minLength": 25
          },
          "sourceSpan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startEvent",
              "endEvent"
            ],
            "properties": {
              "startEvent": {
                "type": "integer",
                "minimum": 1075,
                "maximum": 1132
              },
              "endEvent": {
                "type": "integer",
                "minimum": 1035,
                "maximum": 1132
              }
            }
          },
          "attributionConfidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "attributionBasis": {
            "type": "string",
            "minLength": 40
          },
          "loadBearingLevel": {
            "type": "string",
            "enum": [
              "motion",
              "central",
              "subsidiary"
            ]
          },
          "loadBearingReason": {
            "type": "string",
            "minLength": 60
          },
          "responseIntent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "earlierTargetDescription"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "constructive",
                  "reply"
                ]
              },
              "earlierTargetDescription": {
                "type": "string"
              }
            }
          },
          "contextSummary": {
            "type": "string",
            "minLength": 60
          },
          "candidateConfidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    }
  }
}
