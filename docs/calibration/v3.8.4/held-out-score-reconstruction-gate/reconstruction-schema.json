{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester-v384-assessment-reconstruction",
  "title": "Slugfester v3.8.4 assessment reconstruction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowVersion",
    "rubricVersion",
    "protocolId",
    "debateId",
    "debateNumber",
    "assessmentModel",
    "calibrationOnly",
    "completedAt",
    "isolation",
    "source",
    "sourceLedgerSha256",
    "scorecard",
    "aiExtension",
    "displayContract",
    "audit"
  ],
  "properties": {
    "schemaVersion": {"const": "3.8.4-assessment-reconstruction"},
    "workflowVersion": {"const": "Slugfester End-to-End Consensus Workflow v3.8.4"},
    "rubricVersion": {"const": "Slugfester Reassessment Rubric v3.8.4"},
    "protocolId": {"const": "v3.8.4-heldout-score-reconstruction-gate"},
    "debateId": {"type": "string", "minLength": 1},
    "debateNumber": {"type": "string", "minLength": 1},
    "assessmentModel": {"const": "5.6 Sol"},
    "calibrationOnly": {"const": true},
    "completedAt": {"type": "string", "format": "date-time"},
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "allowedInputs", "prohibitedInputsConfirmed", "contaminationDetected", "statement"],
      "properties": {
        "method": {"const": "fresh-isolated-v384-reconstruction-context"},
        "allowedInputs": {"type": "array", "minItems": 9, "items": {"type": "string"}, "uniqueItems": true},
        "prohibitedInputsConfirmed": {"const": true},
        "contaminationDetected": {"const": false},
        "statement": {"type": "string", "minLength": 40}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lockedSourcePacketSha256",
        "finalLedgerSha256",
        "transcriptSha256",
        "eventsSha256",
        "captionManifestSha256",
        "quoteVerificationSha256",
        "gateManifestSha256",
        "workflowSha256",
        "rubricSha256",
        "manualSha256",
        "schemaSha256"
      ],
      "properties": {
        "lockedSourcePacketSha256": {"$ref": "#/$defs/digest"},
        "finalLedgerSha256": {"$ref": "#/$defs/digest"},
        "transcriptSha256": {"$ref": "#/$defs/digest"},
        "eventsSha256": {"$ref": "#/$defs/digest"},
        "captionManifestSha256": {"$ref": "#/$defs/digest"},
        "quoteVerificationSha256": {"$ref": "#/$defs/digest"},
        "gateManifestSha256": {"$ref": "#/$defs/digest"},
        "workflowSha256": {"$ref": "#/$defs/digest"},
        "rubricSha256": {"$ref": "#/$defs/digest"},
        "manualSha256": {"$ref": "#/$defs/digest"},
        "schemaSha256": {"$ref": "#/$defs/digest"}
      }
    },
    "sourceLedgerSha256": {"$ref": "#/$defs/digest"},
    "scorecard": {"$ref": "#/$defs/scorecard"},
    "aiExtension": {"$ref": "#/$defs/aiExtension"},
    "displayContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionTitle", "placement", "defaultCollapsed", "visualVariant", "byline", "prohibitedLanguageScanPassed"],
      "properties": {
        "sectionTitle": {"const": "AI Extension"},
        "placement": {"const": "immediately-after-overall-commentary"},
        "defaultCollapsed": {"const": true},
        "visualVariant": {"const": "ai-distinct"},
        "byline": {"const": "Assessments made by 5.6 Sol. — Rubric: Slugfester Reassessment Rubric v2."},
        "prohibitedLanguageScanPassed": {"const": true}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allScoresCopiedFromLedger",
        "allParticipantMovesSourceMapped",
        "allRepresentativeQuotesVerified",
        "allCritiquesWithinWordLimit",
        "overallMinimumsMet",
        "allExtensionItemsNoveltyMapped",
        "aiMaterialExcludedFromParticipantScores",
        "legacyAssessmentUnavailable"
      ],
      "properties": {
        "allScoresCopiedFromLedger": {"const": true},
        "allParticipantMovesSourceMapped": {"const": true},
        "allRepresentativeQuotesVerified": {"const": true},
        "allCritiquesWithinWordLimit": {"const": true},
        "overallMinimumsMet": {"const": true},
        "allExtensionItemsNoveltyMapped": {"const": true},
        "aiMaterialExcludedFromParticipantScores": {"const": true},
        "legacyAssessmentUnavailable": {"const": true}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "sideScores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pro", "con"],
      "properties": {
        "pro": {"$ref": "#/$defs/score"},
        "con": {"$ref": "#/$defs/score"}
      }
    },
    "sides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pro", "con"],
      "properties": {
        "pro": {"$ref": "#/$defs/side"},
        "con": {"$ref": "#/$defs/side"}
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "speaker", "color"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "speaker": {"type": "string", "minLength": 1},
        "color": {"enum": ["teal", "coral"]}
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "context", "sourceMoveId", "audioVerified"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 20},
        "sourceMoveId": {"type": "string", "minLength": 1},
        "audioVerified": {"const": true}
      }
    },
    "quotes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pro", "con"],
      "properties": {
        "pro": {"$ref": "#/$defs/quote"},
        "con": {"$ref": "#/$defs/quote"}
      }
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "type", "slug", "context"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "type": {"enum": ["fallacy", "bias"]},
        "slug": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 20}
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moveId", "time", "role", "words", "score", "critique", "tags"],
      "properties": {
        "moveId": {"type": "string", "minLength": 1},
        "time": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "words": {"type": "string", "minLength": 1},
        "score": {"$ref": "#/$defs/score"},
        "critique": {"type": "string", "minLength": 1},
        "tags": {"type": "array", "items": {"$ref": "#/$defs/tag"}, "maxItems": 2}
      }
    },
    "nullableArgument": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/argument"}
      ]
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pro", "con"],
      "properties": {
        "pro": {"$ref": "#/$defs/nullableArgument"},
        "con": {"$ref": "#/$defs/nullableArgument"}
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectionId", "title", "timebox", "score", "exchanges"],
      "properties": {
        "sectionId": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "timebox": {"type": "string", "minLength": 1},
        "score": {"$ref": "#/$defs/sideScores"},
        "exchanges": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/exchange"}}
      }
    },
    "blunder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "tagSlugs"],
      "properties": {
        "text": {"type": "string", "minLength": 20},
        "tagSlugs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "overallSide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "strengths", "blunders"],
      "properties": {
        "score": {"$ref": "#/$defs/score"},
        "strengths": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 20}},
        "blunders": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/blunder"}}
      }
    },
    "overall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pro", "con"],
      "properties": {
        "pro": {"$ref": "#/$defs/overallSide"},
        "con": {"$ref": "#/$defs/overallSide"}
      }
    },
    "scorecard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "label",
        "date",
        "duration",
        "youtubeUrl",
        "motion",
        "summary",
        "sourceNote",
        "scoringNote",
        "quotes",
        "sides",
        "score",
        "sections",
        "overall"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "duration": {"type": "string", "minLength": 1},
        "youtubeUrl": {"type": "string", "minLength": 1},
        "motion": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "sourceNote": {"type": "string", "minLength": 1},
        "scoringNote": {"type": "string", "minLength": 1},
        "quotes": {"$ref": "#/$defs/quotes"},
        "sides": {"$ref": "#/$defs/sides"},
        "score": {"$ref": "#/$defs/sideScores"},
        "sections": {"type": "array", "minItems": 4, "maxItems": 7, "items": {"$ref": "#/$defs/section"}},
        "overall": {"$ref": "#/$defs/overall"}
      }
    },
    "novelty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "sourceMoveIds", "explanation"],
      "properties": {
        "classification": {"enum": ["extends", "repairs", "introduces"]},
        "sourceMoveIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "explanation": {"type": "string", "minLength": 20}
      }
    },
    "premise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "novelty"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "novelty": {"$ref": "#/$defs/novelty"}
      }
    },
    "newArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "text", "novelty"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "novelty": {"$ref": "#/$defs/novelty"}
      }
    },
    "extensionSide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thesis", "premises", "conclusion", "newArguments"],
      "properties": {
        "thesis": {"type": "string", "minLength": 1},
        "premises": {"type": "array", "minItems": 4, "maxItems": 6, "items": {"$ref": "#/$defs/premise"}},
        "conclusion": {"type": "string", "minLength": 1},
        "newArguments": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/newArgument"}}
      }
    },
    "aiExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aiGenerated", "disclaimer", "pro", "con"],
      "properties": {
        "aiGenerated": {"const": true},
        "disclaimer": {"type": "string", "minLength": 40},
        "pro": {"$ref": "#/$defs/extensionSide"},
        "con": {"$ref": "#/$defs/extensionSide"}
      }
    }
  }
}
