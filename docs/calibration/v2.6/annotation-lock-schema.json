{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester-v2.6-derived-annotation-lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowVersion", "rubricVersion", "gateId", "debateId", "debateNumber", "model", "calibrationOnly", "lockedAt", "isolation", "source", "annotations", "agreement", "audit"],
  "properties": {
    "schemaVersion": {"const": "2.6-derived-annotation-lock"},
    "workflowVersion": {"const": "Slugfester Reassessment Workflow v2.6"},
    "rubricVersion": {"const": "Slugfester Reassessment Rubric v2.6"},
    "gateId": {"const": "v2.6-held-out-target-contact-gate"},
    "debateId": {"type": "string", "minLength": 1},
    "debateNumber": {"type": "string", "minLength": 1},
    "model": {"const": "5.6 Sol"},
    "calibrationOnly": {"const": true},
    "lockedAt": {"type": "string", "format": "date-time"},
    "isolation": {"type": "object", "additionalProperties": false, "required": ["method", "legacyMaterialAvailable", "numericalScoresAvailable", "statement"], "properties": {"method": {"const": "fresh-v2.6-primitive-adjudication-task"}, "legacyMaterialAvailable": {"const": false}, "numericalScoresAvailable": {"const": false}, "statement": {"type": "string", "minLength": 40}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["passAPath", "passASha256", "passBPath", "passBSha256", "inventoryPath", "inventorySha256"], "properties": {"passAPath": {"type": "string", "minLength": 1}, "passASha256": {"$ref": "#/$defs/digest"}, "passBPath": {"type": "string", "minLength": 1}, "passBSha256": {"$ref": "#/$defs/digest"}, "inventoryPath": {"type": "string", "minLength": 1}, "inventorySha256": {"$ref": "#/$defs/digest"}}},
    "annotations": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/annotation"}},
    "agreement": {"$ref": "#/$defs/agreement"},
    "audit": {"type": "object", "additionalProperties": false, "required": ["primitiveDisagreementCount", "adjudicatedPrimitiveCount", "evidenceOffsetErrors", "derivationMismatches", "unresolvedDisagreements", "movesMissingFinalLock"], "properties": {"primitiveDisagreementCount": {"type": "integer", "minimum": 0}, "adjudicatedPrimitiveCount": {"type": "integer", "minimum": 0}, "evidenceOffsetErrors": {"const": 0}, "derivationMismatches": {"const": 0}, "unresolvedDisagreements": {"const": 0}, "movesMissingFinalLock": {"const": 0}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {"type": ["object", "null"], "additionalProperties": false, "required": ["text", "startChar", "endChar"], "properties": {"text": {"type": "string", "minLength": 1}, "startChar": {"type": "integer", "minimum": 0}, "endChar": {"type": "integer", "minimum": 1}}},
    "sourceKind": {"enum": ["agreement", "adjudication"]},
    "componentOperation": {"type": "object", "additionalProperties": false, "required": ["componentId", "operation", "evidence"], "properties": {"componentId": {"type": "string", "minLength": 1}, "operation": {"type": ["string", "null"], "enum": [null, "accepts", "denies", "distinguishes", "qualifies", "explains", "undermines"]}, "evidence": {"$ref": "#/$defs/evidence"}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["targetRelation", "substitutionType", "substitutionEvidence", "componentOperations", "relevantContraryMaterial", "contraryEvidence", "derivedTargetCoverage"], "properties": {"targetRelation": {"enum": ["not-applicable", "preserved", "substituted"]}, "substitutionType": {"type": ["string", "null"], "enum": [null, "object", "strength", "modality", "comparison-class", "burden"]}, "substitutionEvidence": {"$ref": "#/$defs/evidence"}, "componentOperations": {"type": "array", "items": {"$ref": "#/$defs/componentOperation"}}, "relevantContraryMaterial": {"type": ["boolean", "null"]}, "contraryEvidence": {"$ref": "#/$defs/evidence"}, "derivedTargetCoverage": {"enum": ["not-applicable", "full", "partial", "relevant-nonanswer", "substitution"]}}},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["defectType", "defectEvidence", "targetImpactExplicit", "targetImpactEvidence", "derivedDiagnostic"], "properties": {"defectType": {"enum": ["none", "contradiction", "missing-premise", "ambiguity", "invalid-inference", "unsupported-comparison", "other"]}, "defectEvidence": {"$ref": "#/$defs/evidence"}, "targetImpactExplicit": {"type": "boolean"}, "targetImpactEvidence": {"$ref": "#/$defs/evidence"}, "derivedDiagnostic": {"type": "boolean"}}},
    "reframe": {"type": "object", "additionalProperties": false, "required": ["malformedDemandExplained", "malformedDemandEvidence", "replacementDemandStated", "replacementDemandEvidence", "derivedReframe"], "properties": {"malformedDemandExplained": {"type": "boolean"}, "malformedDemandEvidence": {"$ref": "#/$defs/evidence"}, "replacementDemandStated": {"type": "boolean"}, "replacementDemandEvidence": {"$ref": "#/$defs/evidence"}, "derivedReframe": {"type": "boolean"}}},
    "bridgeContact": {"type": "object", "additionalProperties": false, "required": ["bridgeId", "contactMode"], "properties": {"bridgeId": {"type": "string", "minLength": 1}, "contactMode": {"enum": ["supports", "attacks"]}}},
    "burden": {"type": "object", "additionalProperties": false, "required": ["contactedBridges", "derivedBurdenRelation"], "properties": {"contactedBridges": {"type": "array", "items": {"$ref": "#/$defs/bridgeContact"}}, "derivedBurdenRelation": {"enum": ["completes", "advances-central", "advances-sub-burden", "topical-peripheral", "unadopted-or-irrelevant"]}}},
    "fieldSources": {"type": "object", "additionalProperties": false, "required": ["targetRelation", "substitutionType", "substitutionEvidence", "componentOperations", "relevantContraryMaterial", "contraryEvidence", "defectType", "defectEvidence", "targetImpactExplicit", "targetImpactEvidence", "malformedDemandExplained", "malformedDemandEvidence", "replacementDemandStated", "replacementDemandEvidence", "contactedBridges"], "properties": {"targetRelation": {"$ref": "#/$defs/sourceKind"}, "substitutionType": {"$ref": "#/$defs/sourceKind"}, "substitutionEvidence": {"$ref": "#/$defs/sourceKind"}, "componentOperations": {"$ref": "#/$defs/sourceKind"}, "relevantContraryMaterial": {"$ref": "#/$defs/sourceKind"}, "contraryEvidence": {"$ref": "#/$defs/sourceKind"}, "defectType": {"$ref": "#/$defs/sourceKind"}, "defectEvidence": {"$ref": "#/$defs/sourceKind"}, "targetImpactExplicit": {"$ref": "#/$defs/sourceKind"}, "targetImpactEvidence": {"$ref": "#/$defs/sourceKind"}, "malformedDemandExplained": {"$ref": "#/$defs/sourceKind"}, "malformedDemandEvidence": {"$ref": "#/$defs/sourceKind"}, "replacementDemandStated": {"$ref": "#/$defs/sourceKind"}, "replacementDemandEvidence": {"$ref": "#/$defs/sourceKind"}, "contactedBridges": {"$ref": "#/$defs/sourceKind"}}},
    "annotation": {"type": "object", "additionalProperties": false, "required": ["moveId", "interactionMode", "targetPacketId", "primaryBurdenRouteId", "coveragePrimitives", "diagnosticPrimitives", "reframePrimitives", "burdenPrimitives", "fieldSources", "coverageRationale", "mechanismRationale", "burdenRationale"], "properties": {"moveId": {"type": "string", "minLength": 1}, "interactionMode": {"enum": ["constructive", "responsive"]}, "targetPacketId": {"type": ["string", "null"]}, "primaryBurdenRouteId": {"type": ["string", "null"]}, "coveragePrimitives": {"$ref": "#/$defs/coverage"}, "diagnosticPrimitives": {"$ref": "#/$defs/diagnostic"}, "reframePrimitives": {"$ref": "#/$defs/reframe"}, "burdenPrimitives": {"$ref": "#/$defs/burden"}, "fieldSources": {"$ref": "#/$defs/fieldSources"}, "coverageRationale": {"type": "string", "minLength": 40}, "mechanismRationale": {"type": "string", "minLength": 40}, "burdenRationale": {"type": "string", "minLength": 40}}},
    "agreement": {"type": "object", "additionalProperties": false, "required": ["moveCount", "responsiveMoveCount", "componentContactAgreementCount", "componentContactJudgmentCount", "componentOperationAgreementCount", "componentOperationJudgmentCount", "targetRelationAgreementCount", "defectTypeAgreementCount", "targetImpactAgreementCount", "malformedDemandAgreementCount", "replacementDemandAgreementCount", "bridgeSetAgreementCount", "coverageAgreementCount", "responsiveCoverageAgreementCount", "diagnosticAgreementCount", "reframeAgreementCount", "burdenAgreementCount", "exactDerivedTupleAgreementCount"], "properties": {"moveCount": {"const": 12}, "responsiveMoveCount": {"const": 8}, "componentContactAgreementCount": {"type": "integer", "minimum": 0}, "componentContactJudgmentCount": {"type": "integer", "minimum": 0}, "componentOperationAgreementCount": {"type": "integer", "minimum": 0}, "componentOperationJudgmentCount": {"type": "integer", "minimum": 0}, "targetRelationAgreementCount": {"type": "integer", "minimum": 0, "maximum": 8}, "defectTypeAgreementCount": {"type": "integer", "minimum": 0, "maximum": 12}, "targetImpactAgreementCount": {"type": "integer", "minimum": 0, "maximum": 12}, "malformedDemandAgreementCount": {"type": "integer", "minimum": 0, "maximum": 12}, "replacementDemandAgreementCount": {"type": "integer", "minimum": 0, "maximum": 12}, "bridgeSetAgreementCount": {"type": "integer", "minimum": 0, "maximum": 12}, "coverageAgreementCount": {"type": "integer", "minimum": 0, "maximum": 12}, "responsiveCoverageAgreementCount": {"type": "integer", "minimum": 0, "maximum": 8}, "diagnosticAgreementCount": {"type": "integer", "minimum": 0, "maximum": 12}, "reframeAgreementCount": {"type": "integer", "minimum": 0, "maximum": 12}, "burdenAgreementCount": {"type": "integer", "minimum": 0, "maximum": 12}, "exactDerivedTupleAgreementCount": {"type": "integer", "minimum": 0, "maximum": 12}}}
  }
}
