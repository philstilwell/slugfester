{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester-v2.6-target-contact-development",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowVersion", "rubricVersion", "sourceGateId", "heldOutEligible", "retiredDebates", "cases", "audit"],
  "properties": {
    "schemaVersion": {"const": "2.6-target-contact-development"},
    "workflowVersion": {"const": "Slugfester Reassessment Workflow v2.6"},
    "rubricVersion": {"const": "Slugfester Reassessment Rubric v2.6"},
    "sourceGateId": {"const": "v2.5-held-out-derived-annotation-gate"},
    "heldOutEligible": {"const": false},
    "retiredDebates": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "cases": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/case"}},
    "audit": {"type": "object", "additionalProperties": false, "required": ["caseCount", "componentContactDisagreementCount", "coverageDisagreementCount", "targetRelationDisagreementCount", "operationEvidenceErrors", "substitutionEvidenceErrors", "graphErrors", "derivationErrors", "heldOutContamination"], "properties": {"caseCount": {"const": 8}, "componentContactDisagreementCount": {"const": 10}, "coverageDisagreementCount": {"const": 6}, "targetRelationDisagreementCount": {"const": 3}, "operationEvidenceErrors": {"const": 0}, "substitutionEvidenceErrors": {"const": 0}, "graphErrors": {"const": 0}, "derivationErrors": {"const": 0}, "heldOutContamination": {"const": 0}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "span": {"type": "object", "additionalProperties": false, "required": ["startMs", "endMs"], "properties": {"startMs": {"type": "integer", "minimum": 0}, "endMs": {"type": "integer", "minimum": 1}}},
    "evidence": {"type": ["object", "null"], "additionalProperties": false, "required": ["text", "startChar", "endChar"], "properties": {"text": {"type": "string", "minLength": 1}, "startChar": {"type": "integer", "minimum": 0}, "endChar": {"type": "integer", "minimum": 1}}},
    "component": {"type": "object", "additionalProperties": false, "required": ["id", "text", "kind", "dependsOn"], "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 5}, "kind": {"enum": ["fact-premise", "rule-comparison", "inference", "burden", "modality", "conclusion"]}, "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["id", "targetSpeaker", "sourceSpan", "sourceExcerpt", "claim", "targetRelationToMove", "interveningOpponentClaim", "exceptionRationale", "indispensableComponents"], "properties": {"id": {"type": "string", "minLength": 1}, "targetSpeaker": {"type": "string", "minLength": 1}, "sourceSpan": {"$ref": "#/$defs/span"}, "sourceExcerpt": {"type": "string", "minLength": 20}, "claim": {"type": "string", "minLength": 10}, "targetRelationToMove": {"enum": ["immediate-opponent-claim", "earlier-load-bearing-claim"]}, "interveningOpponentClaim": {"type": "boolean"}, "exceptionRationale": {"type": ["string", "null"]}, "indispensableComponents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}}}},
    "componentOperation": {"type": "object", "additionalProperties": false, "required": ["componentId", "operation", "evidence"], "properties": {"componentId": {"type": "string", "minLength": 1}, "operation": {"type": ["string", "null"], "enum": [null, "accepts", "denies", "distinguishes", "qualifies", "explains", "undermines"]}, "evidence": {"$ref": "#/$defs/evidence"}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["targetRelation", "substitutionType", "substitutionEvidence", "componentOperations", "relevantContraryMaterial", "contraryEvidence", "derivedTargetCoverage"], "properties": {"targetRelation": {"enum": ["preserved", "substituted"]}, "substitutionType": {"type": ["string", "null"], "enum": [null, "object", "strength", "modality", "comparison-class", "burden"]}, "substitutionEvidence": {"$ref": "#/$defs/evidence"}, "componentOperations": {"type": "array", "items": {"$ref": "#/$defs/componentOperation"}}, "relevantContraryMaterial": {"type": "boolean"}, "contraryEvidence": {"$ref": "#/$defs/evidence"}, "derivedTargetCoverage": {"enum": ["full", "partial", "relevant-nonanswer", "substitution"]}}},
    "disagreements": {"type": "object", "additionalProperties": false, "required": ["componentIds", "coverage", "targetRelation"], "properties": {"componentIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "coverage": {"type": "boolean"}, "targetRelation": {"type": "boolean"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["inventoryPath", "inventorySha256", "passAPath", "passASha256", "passBPath", "passBSha256", "lockPath", "lockSha256"], "properties": {"inventoryPath": {"type": "string", "minLength": 1}, "inventorySha256": {"$ref": "#/$defs/digest"}, "passAPath": {"type": "string", "minLength": 1}, "passASha256": {"$ref": "#/$defs/digest"}, "passBPath": {"type": "string", "minLength": 1}, "passBSha256": {"$ref": "#/$defs/digest"}, "lockPath": {"type": "string", "minLength": 1}, "lockSha256": {"$ref": "#/$defs/digest"}}},
    "case": {"type": "object", "additionalProperties": false, "required": ["caseId", "debateId", "debateNumber", "moveId", "speaker", "sourceSpan", "sourceExcerpt", "sourceExcerptSha256", "provenance", "v25Disagreements", "targetPacket", "finalCoverage", "rationale"], "properties": {"caseId": {"type": "string", "minLength": 1}, "debateId": {"type": "string", "minLength": 1}, "debateNumber": {"type": "string", "minLength": 1}, "moveId": {"type": "string", "minLength": 1}, "speaker": {"type": "string", "minLength": 1}, "sourceSpan": {"$ref": "#/$defs/span"}, "sourceExcerpt": {"type": "string", "minLength": 30}, "sourceExcerptSha256": {"$ref": "#/$defs/digest"}, "provenance": {"$ref": "#/$defs/provenance"}, "v25Disagreements": {"$ref": "#/$defs/disagreements"}, "targetPacket": {"$ref": "#/$defs/target"}, "finalCoverage": {"$ref": "#/$defs/coverage"}, "rationale": {"type": "string", "minLength": 60}}}
  }
}
