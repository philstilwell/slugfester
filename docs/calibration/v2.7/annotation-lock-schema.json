{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester-v2.7-annotation-lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowVersion", "rubricVersion", "gateId", "lane", "debateId", "debateNumber", "model", "calibrationOnly", "lockedAt", "isolation", "source", "annotations", "agreement", "audit"],
  "properties": {
    "schemaVersion": {"const": "2.7-annotation-lock"},
    "workflowVersion": {"const": "Slugfester Reassessment Workflow v2.7"},
    "rubricVersion": {"const": "Slugfester Reassessment Rubric v2.7"},
    "gateId": {"enum": ["v2.7-dyadic-held-out-gate", "v2.7-multi-speaker-held-out-gate"]},
    "lane": {"enum": ["dyadic", "multi-speaker"]},
    "debateId": {"type": "string", "minLength": 1},
    "debateNumber": {"type": "string", "minLength": 1},
    "model": {"const": "5.6 Sol"},
    "calibrationOnly": {"const": true},
    "lockedAt": {"type": "string", "format": "date-time"},
    "isolation": {"type": "object", "additionalProperties": false, "required": ["method", "legacyMaterialAvailable", "numericalScoresAvailable", "statement"], "properties": {"method": {"const": "fresh-v2.7-primitive-adjudication-task"}, "legacyMaterialAvailable": {"const": false}, "numericalScoresAvailable": {"const": false}, "statement": {"type": "string", "minLength": 40}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["passAPath", "passASha256", "passBPath", "passBSha256", "inventoryPath", "inventorySha256"], "properties": {"passAPath": {"type": "string", "minLength": 1}, "passASha256": {"$ref": "#/$defs/digest"}, "passBPath": {"type": "string", "minLength": 1}, "passBSha256": {"$ref": "#/$defs/digest"}, "inventoryPath": {"type": "string", "minLength": 1}, "inventorySha256": {"$ref": "#/$defs/digest"}}},
    "annotations": {"type": "array", "minItems": 12, "maxItems": 16, "items": {"$ref": "#/$defs/annotation"}},
    "agreement": {"$ref": "#/$defs/agreement"},
    "audit": {"type": "object", "additionalProperties": false, "required": ["primitiveDisagreementCount", "adjudicatedPrimitiveCount", "evidenceOffsetErrors", "targetAxisApplicabilityErrors", "diagnosticObjectErrors", "derivationMismatches", "unresolvedDisagreements", "movesMissingFinalLock"], "properties": {"primitiveDisagreementCount": {"type": "integer", "minimum": 0}, "adjudicatedPrimitiveCount": {"type": "integer", "minimum": 0}, "evidenceOffsetErrors": {"const": 0}, "targetAxisApplicabilityErrors": {"const": 0}, "diagnosticObjectErrors": {"const": 0}, "derivationMismatches": {"const": 0}, "unresolvedDisagreements": {"const": 0}, "movesMissingFinalLock": {"const": 0}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {"type": ["object", "null"], "additionalProperties": false, "required": ["text", "startChar", "endChar"], "properties": {"text": {"type": "string", "minLength": 1}, "startChar": {"type": "integer", "minimum": 0}, "endChar": {"type": "integer", "minimum": 1}}},
    "sourceKind": {"enum": ["agreement", "adjudication"]},
    "componentOperation": {"type": "object", "additionalProperties": false, "required": ["componentId", "operation", "evidence"], "properties": {"componentId": {"type": "string", "minLength": 1}, "operation": {"type": ["string", "null"], "enum": [null, "accepts", "denies", "distinguishes", "qualifies", "explains", "undermines"]}, "evidence": {"$ref": "#/$defs/evidence"}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["targetObjectRelation", "objectChangeType", "objectEvidence", "targetScopeRelation", "scopeEvidence", "targetBurdenRelation", "burdenEvidence", "componentOperations", "relevantContraryMaterial", "contraryEvidence", "derivedTargetDisposition", "derivedTargetCoverage"], "properties": {"targetObjectRelation": {"enum": ["not-applicable", "same", "changed"]}, "objectChangeType": {"type": ["string", "null"], "enum": [null, "subject", "referent", "comparison-class", "baseline", "question-type"]}, "objectEvidence": {"$ref": "#/$defs/evidence"}, "targetScopeRelation": {"enum": ["not-applicable", "same", "narrowed", "strengthened", "modality-shift"]}, "scopeEvidence": {"$ref": "#/$defs/evidence"}, "targetBurdenRelation": {"enum": ["not-applicable", "retained", "reassigned", "replaced"]}, "burdenEvidence": {"$ref": "#/$defs/evidence"}, "componentOperations": {"type": "array", "items": {"$ref": "#/$defs/componentOperation"}}, "relevantContraryMaterial": {"type": ["boolean", "null"]}, "contraryEvidence": {"$ref": "#/$defs/evidence"}, "derivedTargetDisposition": {"enum": ["not-applicable", "preserved", "substituted"]}, "derivedTargetCoverage": {"enum": ["not-applicable", "full", "partial", "relevant-nonanswer", "nonanswer", "substitution"]}}},
    "diagnosticObject": {"type": ["object", "null"], "additionalProperties": false, "required": ["objectType", "objectId"], "properties": {"objectType": {"enum": ["target-packet", "target-component"]}, "objectId": {"type": "string", "minLength": 1}}},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["applicability", "defectType", "defectObject", "defectEvidence", "impactMode", "impactEvidence", "derivedDiagnostic"], "properties": {"applicability": {"enum": ["not-applicable", "applicable"]}, "defectType": {"enum": ["none", "contradiction", "missing-premise", "ambiguity", "invalid-inference", "unsupported-comparison", "irrelevance", "evidential-insufficiency", "scope-mismatch", "attribution-error"]}, "defectObject": {"$ref": "#/$defs/diagnosticObject"}, "defectEvidence": {"$ref": "#/$defs/evidence"}, "impactMode": {"enum": ["not-applicable", "none", "verdict", "inferential-consequence"]}, "impactEvidence": {"$ref": "#/$defs/evidence"}, "derivedDiagnostic": {"type": "boolean"}}},
    "reframe": {"type": "object", "additionalProperties": false, "required": ["malformedDemandExplained", "malformedDemandEvidence", "replacementDemandStated", "replacementDemandEvidence", "derivedReframe"], "properties": {"malformedDemandExplained": {"type": "boolean"}, "malformedDemandEvidence": {"$ref": "#/$defs/evidence"}, "replacementDemandStated": {"type": "boolean"}, "replacementDemandEvidence": {"$ref": "#/$defs/evidence"}, "derivedReframe": {"type": "boolean"}}},
    "bridgeContact": {"type": "object", "additionalProperties": false, "required": ["bridgeId", "contactMode"], "properties": {"bridgeId": {"type": "string", "minLength": 1}, "contactMode": {"enum": ["supports", "attacks"]}}},
    "burden": {"type": "object", "additionalProperties": false, "required": ["contactedBridges", "derivedBurdenRelation"], "properties": {"contactedBridges": {"type": "array", "items": {"$ref": "#/$defs/bridgeContact"}}, "derivedBurdenRelation": {"enum": ["completes", "advances-central", "advances-sub-burden", "topical-peripheral", "unadopted-or-irrelevant"]}}},
    "fieldSources": {"type": "object", "additionalProperties": false, "required": ["targetObjectRelation", "objectChangeType", "objectEvidence", "targetScopeRelation", "scopeEvidence", "targetBurdenRelation", "burdenEvidence", "componentOperations", "relevantContraryMaterial", "contraryEvidence", "defectType", "defectObject", "defectEvidence", "impactMode", "impactEvidence", "malformedDemandExplained", "malformedDemandEvidence", "replacementDemandStated", "replacementDemandEvidence", "contactedBridges"], "properties": {"targetObjectRelation": {"$ref": "#/$defs/sourceKind"}, "objectChangeType": {"$ref": "#/$defs/sourceKind"}, "objectEvidence": {"$ref": "#/$defs/sourceKind"}, "targetScopeRelation": {"$ref": "#/$defs/sourceKind"}, "scopeEvidence": {"$ref": "#/$defs/sourceKind"}, "targetBurdenRelation": {"$ref": "#/$defs/sourceKind"}, "burdenEvidence": {"$ref": "#/$defs/sourceKind"}, "componentOperations": {"$ref": "#/$defs/sourceKind"}, "relevantContraryMaterial": {"$ref": "#/$defs/sourceKind"}, "contraryEvidence": {"$ref": "#/$defs/sourceKind"}, "defectType": {"$ref": "#/$defs/sourceKind"}, "defectObject": {"$ref": "#/$defs/sourceKind"}, "defectEvidence": {"$ref": "#/$defs/sourceKind"}, "impactMode": {"$ref": "#/$defs/sourceKind"}, "impactEvidence": {"$ref": "#/$defs/sourceKind"}, "malformedDemandExplained": {"$ref": "#/$defs/sourceKind"}, "malformedDemandEvidence": {"$ref": "#/$defs/sourceKind"}, "replacementDemandStated": {"$ref": "#/$defs/sourceKind"}, "replacementDemandEvidence": {"$ref": "#/$defs/sourceKind"}, "contactedBridges": {"$ref": "#/$defs/sourceKind"}}},
    "annotation": {"type": "object", "additionalProperties": false, "required": ["moveId", "interactionMode", "targetPacketId", "primaryBurdenRouteId", "coveragePrimitives", "diagnosticPrimitives", "reframePrimitives", "burdenPrimitives", "fieldSources", "coverageRationale", "mechanismRationale", "burdenRationale"], "properties": {"moveId": {"type": "string", "minLength": 1}, "interactionMode": {"enum": ["constructive", "responsive"]}, "targetPacketId": {"type": ["string", "null"]}, "primaryBurdenRouteId": {"type": ["string", "null"]}, "coveragePrimitives": {"$ref": "#/$defs/coverage"}, "diagnosticPrimitives": {"$ref": "#/$defs/diagnostic"}, "reframePrimitives": {"$ref": "#/$defs/reframe"}, "burdenPrimitives": {"$ref": "#/$defs/burden"}, "fieldSources": {"$ref": "#/$defs/fieldSources"}, "coverageRationale": {"type": "string", "minLength": 40}, "mechanismRationale": {"type": "string", "minLength": 40}, "burdenRationale": {"type": "string", "minLength": 40}}},
    "agreement": {"type": "object", "additionalProperties": false, "required": ["moveCount", "responsiveMoveCount", "targetObjectAgreementCount", "targetScopeAgreementCount", "targetBurdenAgreementCount", "componentContactAgreementCount", "componentContactJudgmentCount", "componentOperationAgreementCount", "componentOperationJudgmentCount", "coverageAgreementCount", "responsiveCoverageAgreementCount", "defectTypeAgreementCount", "diagnosticObjectAgreementCount", "diagnosticObjectJudgmentCount", "impactModeAgreementCount", "diagnosticAgreementCount", "malformedDemandAgreementCount", "replacementDemandAgreementCount", "bridgeSetAgreementCount", "reframeAgreementCount", "burdenAgreementCount", "exactDerivedTupleAgreementCount"], "properties": {"moveCount": {"enum": [12, 16]}, "responsiveMoveCount": {"enum": [8, 12]}, "targetObjectAgreementCount": {"type": "integer", "minimum": 0}, "targetScopeAgreementCount": {"type": "integer", "minimum": 0}, "targetBurdenAgreementCount": {"type": "integer", "minimum": 0}, "componentContactAgreementCount": {"type": "integer", "minimum": 0}, "componentContactJudgmentCount": {"type": "integer", "minimum": 0}, "componentOperationAgreementCount": {"type": "integer", "minimum": 0}, "componentOperationJudgmentCount": {"type": "integer", "minimum": 0}, "coverageAgreementCount": {"type": "integer", "minimum": 0}, "responsiveCoverageAgreementCount": {"type": "integer", "minimum": 0}, "defectTypeAgreementCount": {"type": "integer", "minimum": 0}, "diagnosticObjectAgreementCount": {"type": "integer", "minimum": 0}, "diagnosticObjectJudgmentCount": {"type": "integer", "minimum": 0}, "impactModeAgreementCount": {"type": "integer", "minimum": 0}, "diagnosticAgreementCount": {"type": "integer", "minimum": 0}, "malformedDemandAgreementCount": {"type": "integer", "minimum": 0}, "replacementDemandAgreementCount": {"type": "integer", "minimum": 0}, "bridgeSetAgreementCount": {"type": "integer", "minimum": 0}, "reframeAgreementCount": {"type": "integer", "minimum": 0}, "burdenAgreementCount": {"type": "integer", "minimum": 0}, "exactDerivedTupleAgreementCount": {"type": "integer", "minimum": 0}}}
  }
}
