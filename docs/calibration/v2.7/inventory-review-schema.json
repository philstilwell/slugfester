{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester-v2.7-inventory-review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowVersion", "gateId", "lane", "debateId", "debateNumber", "reviewRound", "reviewedAt", "reviewerModel", "calibrationOnly", "isolation", "source", "findings", "repairs", "nextReviewTrigger", "audit"],
  "properties": {
    "schemaVersion": {"const": "2.7-inventory-review"},
    "workflowVersion": {"const": "Slugfester Reassessment Workflow v2.7"},
    "gateId": {"enum": ["v2.7-dyadic-held-out-gate", "v2.7-multi-speaker-held-out-gate"]},
    "lane": {"enum": ["dyadic", "multi-speaker"]},
    "debateId": {"type": "string", "minLength": 1},
    "debateNumber": {"type": "string", "minLength": 1},
    "reviewRound": {"type": "integer", "minimum": 1, "maximum": 3},
    "reviewedAt": {"type": "string", "format": "date-time"},
    "reviewerModel": {"const": "5.6 Sol"},
    "calibrationOnly": {"const": true},
    "isolation": {"$ref": "#/$defs/isolation"},
    "source": {"$ref": "#/$defs/source"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "repairs": {"type": "array", "items": {"$ref": "#/$defs/repair"}},
    "nextReviewTrigger": {"type": "object", "additionalProperties": false, "required": ["required", "categories", "rationale"], "properties": {"required": {"type": "boolean"}, "categories": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/trigger"}}, "rationale": {"type": "string", "minLength": 20}}},
    "audit": {"$ref": "#/$defs/audit"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "trigger": {"enum": ["meaning", "sampling", "speaker-ownership", "ownership-adoption", "burden-route-or-tier", "atomicity", "target-packet", "component-graph", "target-recency", "target-side"]},
    "isolation": {"type": "object", "additionalProperties": false, "required": ["method", "legacyMaterialAccessed", "developmentExamplesAccessed", "annotationPassesAvailable", "priorReviewAvailable", "statement"], "properties": {"method": {"const": "fresh-independent-v2.7-inventory-review"}, "legacyMaterialAccessed": {"const": false}, "developmentExamplesAccessed": {"const": false}, "annotationPassesAvailable": {"const": false}, "priorReviewAvailable": {"type": "boolean"}, "statement": {"type": "string", "minLength": 40}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["inputInventoryPath", "inputInventorySha256", "outputInventoryPath", "outputInventorySha256", "priorReviewPath", "priorReviewSha256", "transcriptSha256", "eventsSha256", "manifestSha256", "workflowSha256", "inventorySchemaSha256", "gateManifestSha256"], "properties": {"inputInventoryPath": {"type": "string", "minLength": 1}, "inputInventorySha256": {"$ref": "#/$defs/digest"}, "outputInventoryPath": {"type": "string", "minLength": 1}, "outputInventorySha256": {"$ref": "#/$defs/digest"}, "priorReviewPath": {"type": ["string", "null"]}, "priorReviewSha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]}, "transcriptSha256": {"$ref": "#/$defs/digest"}, "eventsSha256": {"$ref": "#/$defs/digest"}, "manifestSha256": {"$ref": "#/$defs/digest"}, "workflowSha256": {"$ref": "#/$defs/digest"}, "inventorySchemaSha256": {"$ref": "#/$defs/digest"}, "gateManifestSha256": {"$ref": "#/$defs/digest"}}},
    "finding": {"type": "object", "additionalProperties": false, "required": ["findingId", "category", "moveId", "description", "disposition"], "properties": {"findingId": {"type": "string", "minLength": 1}, "category": {"enum": ["source-fidelity", "atomicity", "target-packet", "target-side", "ownership-adoption", "burden-route", "component-graph", "component-overlap", "target-recency", "sampling", "speaker-attribution" ]}, "moveId": {"type": ["string", "null"]}, "description": {"type": "string", "minLength": 20}, "disposition": {"enum": ["repaired", "not-a-violation"]}}},
    "repair": {"type": "object", "additionalProperties": false, "required": ["findingId", "change", "triggerCategory"], "properties": {"findingId": {"type": "string", "minLength": 1}, "change": {"type": "string", "minLength": 20}, "triggerCategory": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/trigger"}]}}},
    "audit": {"type": "object", "additionalProperties": false, "required": ["sourceFidelityViolations", "atomicityViolations", "targetPacketViolations", "targetSideViolations", "ownershipAdoptionViolations", "burdenRouteViolations", "componentGraphViolations", "componentOverlapViolations", "targetRecencyViolations", "samplingViolations", "speakerAttributionViolations", "unresolvedFindings", "outputInventoryValidatorPassed"], "properties": {"sourceFidelityViolations": {"const": 0}, "atomicityViolations": {"const": 0}, "targetPacketViolations": {"const": 0}, "targetSideViolations": {"const": 0}, "ownershipAdoptionViolations": {"const": 0}, "burdenRouteViolations": {"const": 0}, "componentGraphViolations": {"const": 0}, "componentOverlapViolations": {"const": 0}, "targetRecencyViolations": {"const": 0}, "samplingViolations": {"const": 0}, "speakerAttributionViolations": {"const": 0}, "unresolvedFindings": {"const": 0}, "outputInventoryValidatorPassed": {"const": true}}}
  }
}
