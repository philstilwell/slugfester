{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester-v2.7-dual-lane-gate-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowVersion", "rubricVersion", "preregisteredAt", "developmentCheckpointCommit", "developmentFrozen", "selectionProtocol", "retiredDebateIds", "lanes", "thresholds", "denominators", "hardGates", "stopRule", "frozenSources"],
  "properties": {
    "schemaVersion": {"const": "2.7-dual-lane-gate-manifest"},
    "workflowVersion": {"const": "Slugfester Reassessment Workflow v2.7"},
    "rubricVersion": {"const": "Slugfester Reassessment Rubric v2.7"},
    "preregisteredAt": {"type": "string", "format": "date-time"},
    "developmentCheckpointCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "developmentFrozen": {"const": true},
    "selectionProtocol": {"type": "object", "additionalProperties": false, "required": ["metadataOnly", "transcriptsOpenedBeforeLock", "legacyAssessmentsOpenedBeforeLock", "randomizationSeed", "eligiblePoolPath", "eligiblePoolSha256", "selectionStatement"], "properties": {"metadataOnly": {"const": true}, "transcriptsOpenedBeforeLock": {"const": false}, "legacyAssessmentsOpenedBeforeLock": {"const": false}, "randomizationSeed": {"type": "string", "minLength": 16}, "eligiblePoolPath": {"type": "string", "minLength": 1}, "eligiblePoolSha256": {"$ref": "#/$defs/digest"}, "selectionStatement": {"type": "string", "minLength": 60}}},
    "retiredDebateIds": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lanes": {"type": "object", "additionalProperties": false, "required": ["dyadic", "multiSpeaker"], "properties": {"dyadic": {"$ref": "#/$defs/lane"}, "multiSpeaker": {"$ref": "#/$defs/lane"}}},
    "thresholds": {"type": "object"},
    "denominators": {"type": "object"},
    "hardGates": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stopRule": {"type": "object", "additionalProperties": false, "required": ["classificationOnly", "independentLaneDecisions", "failedLaneMayBeIterated", "passingLaneRemainsFrozen", "numericalScoringAuthorized"], "properties": {"classificationOnly": {"const": true}, "independentLaneDecisions": {"const": true}, "failedLaneMayBeIterated": {"const": true}, "passingLaneRemainsFrozen": {"const": true}, "numericalScoringAuthorized": {"const": false}}},
    "frozenSources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "side": {"type": "object", "additionalProperties": false, "required": ["label", "speakers"], "properties": {"label": {"type": "string", "minLength": 1}, "speakers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "debate": {"type": "object", "additionalProperties": false, "required": ["debateId", "number", "videoId", "motion", "sides", "speakerCount", "transcriptChainPresentAtSelection"], "properties": {"debateId": {"type": "string", "minLength": 1}, "number": {"type": "string", "minLength": 1}, "videoId": {"type": "string", "minLength": 1}, "motion": {"type": "string", "minLength": 20}, "sides": {"type": "object", "additionalProperties": false, "required": ["pro", "con"], "properties": {"pro": {"$ref": "#/$defs/side"}, "con": {"$ref": "#/$defs/side"}}}, "speakerCount": {"type": "integer", "minimum": 2, "maximum": 4}, "transcriptChainPresentAtSelection": {"const": true}}},
    "lane": {"type": "object", "additionalProperties": false, "required": ["gateId", "lane", "sampleSize", "moveCountPerDebate", "constructiveCountPerDebate", "responsiveCountPerDebate", "requiredIndependentSemanticReviews", "debates"], "properties": {"gateId": {"enum": ["v2.7-dyadic-held-out-gate", "v2.7-multi-speaker-held-out-gate"]}, "lane": {"enum": ["dyadic", "multi-speaker"]}, "sampleSize": {"const": 3}, "moveCountPerDebate": {"enum": [12, 16]}, "constructiveCountPerDebate": {"const": 4}, "responsiveCountPerDebate": {"enum": [8, 12]}, "requiredIndependentSemanticReviews": {"enum": [1, 2]}, "debates": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/debate"}}}}
  }
}
