{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester-v2.7-single-annotation-pass",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "workflowVersion", "rubricVersion", "gateId", "lane", "debateId", "debateNumber", "pass", "model", "calibrationOnly", "completedAt", "isolation", "source", "annotations", "audit"],
  "properties": {
    "schemaVersion": {"const": "2.7-single-annotation-pass"},
    "workflowVersion": {"const": "Slugfester Reassessment Workflow v2.7"},
    "rubricVersion": {"const": "Slugfester Reassessment Rubric v2.7"},
    "gateId": {"enum": ["v2.7-dyadic-held-out-gate", "v2.7-multi-speaker-held-out-gate"]},
    "lane": {"enum": ["dyadic", "multi-speaker"]},
    "debateId": {"type": "string", "minLength": 1},
    "debateNumber": {"type": "string", "minLength": 1},
    "pass": {"enum": ["A", "B"]},
    "model": {"const": "5.6 Sol"},
    "calibrationOnly": {"const": true},
    "completedAt": {"type": "string", "format": "date-time"},
    "isolation": {"$ref": "#/$defs/isolation"},
    "source": {"$ref": "#/$defs/source"},
    "annotations": {"type": "array", "minItems": 12, "maxItems": 16, "items": {"$ref": "#/$defs/annotation"}},
    "audit": {"$ref": "#/$defs/audit"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {"type": ["object", "null"], "additionalProperties": false, "required": ["text", "startChar", "endChar"], "properties": {"text": {"type": "string", "minLength": 1}, "startChar": {"type": "integer", "minimum": 0}, "endChar": {"type": "integer", "minimum": 1}}},
    "isolation": {"type": "object", "additionalProperties": false, "required": ["method", "allowedInputs", "prohibitedInputsConfirmed", "contaminationDetected", "statement"], "properties": {"method": {"const": "fresh-isolated-v2.7-single-schema-annotation-task"}, "allowedInputs": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}}, "prohibitedInputsConfirmed": {"const": true}, "contaminationDetected": {"const": false}, "statement": {"type": "string", "minLength": 40}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["videoId", "inventoryPath", "inventorySha256", "transcriptSha256", "eventsSha256", "manifestSha256", "gateManifestSha256", "workflowSha256", "rubricSha256", "schemaSha256", "developmentManualSha256", "developmentExamplesSha256", "limitations"], "properties": {"videoId": {"type": "string", "minLength": 1}, "inventoryPath": {"type": "string", "minLength": 1}, "inventorySha256": {"$ref": "#/$defs/digest"}, "transcriptSha256": {"$ref": "#/$defs/digest"}, "eventsSha256": {"$ref": "#/$defs/digest"}, "manifestSha256": {"$ref": "#/$defs/digest"}, "gateManifestSha256": {"$ref": "#/$defs/digest"}, "workflowSha256": {"$ref": "#/$defs/digest"}, "rubricSha256": {"$ref": "#/$defs/digest"}, "schemaSha256": {"$ref": "#/$defs/digest"}, "developmentManualSha256": {"$ref": "#/$defs/digest"}, "developmentExamplesSha256": {"$ref": "#/$defs/digest"}, "limitations": {"type": "string", "minLength": 1}}},
    "componentOperation": {"type": "object", "additionalProperties": false, "required": ["componentId", "operation", "evidence"], "properties": {"componentId": {"type": "string", "minLength": 1}, "operation": {"type": ["string", "null"], "enum": [null, "accepts", "denies", "distinguishes", "qualifies", "explains", "undermines"]}, "evidence": {"$ref": "#/$defs/evidence"}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["targetObjectRelation", "objectChangeType", "objectEvidence", "targetScopeRelation", "scopeEvidence", "targetBurdenRelation", "burdenEvidence", "componentOperations", "relevantContraryMaterial", "contraryEvidence", "derivedTargetDisposition", "derivedTargetCoverage"], "properties": {"targetObjectRelation": {"enum": ["not-applicable", "same", "changed"]}, "objectChangeType": {"type": ["string", "null"], "enum": [null, "subject", "referent", "comparison-class", "baseline", "question-type"]}, "objectEvidence": {"$ref": "#/$defs/evidence"}, "targetScopeRelation": {"enum": ["not-applicable", "same", "narrowed", "strengthened", "modality-shift"]}, "scopeEvidence": {"$ref": "#/$defs/evidence"}, "targetBurdenRelation": {"enum": ["not-applicable", "retained", "reassigned", "replaced"]}, "burdenEvidence": {"$ref": "#/$defs/evidence"}, "componentOperations": {"type": "array", "items": {"$ref": "#/$defs/componentOperation"}}, "relevantContraryMaterial": {"type": ["boolean", "null"]}, "contraryEvidence": {"$ref": "#/$defs/evidence"}, "derivedTargetDisposition": {"enum": ["not-applicable", "preserved", "substituted"]}, "derivedTargetCoverage": {"enum": ["not-applicable", "full", "partial", "relevant-nonanswer", "nonanswer", "substitution"]}}},
    "diagnosticObject": {"type": ["object", "null"], "additionalProperties": false, "required": ["objectType", "objectId"], "properties": {"objectType": {"enum": ["target-packet", "target-component"]}, "objectId": {"type": "string", "minLength": 1}}},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["applicability", "defectType", "defectObject", "defectEvidence", "impactMode", "impactEvidence", "derivedDiagnostic"], "properties": {"applicability": {"enum": ["not-applicable", "applicable"]}, "defectType": {"enum": ["none", "contradiction", "missing-premise", "ambiguity", "invalid-inference", "unsupported-comparison", "irrelevance", "evidential-insufficiency", "scope-mismatch", "attribution-error"]}, "defectObject": {"$ref": "#/$defs/diagnosticObject"}, "defectEvidence": {"$ref": "#/$defs/evidence"}, "impactMode": {"enum": ["not-applicable", "none", "verdict", "inferential-consequence"]}, "impactEvidence": {"$ref": "#/$defs/evidence"}, "derivedDiagnostic": {"type": "boolean"}}},
    "reframe": {"type": "object", "additionalProperties": false, "required": ["malformedDemandExplained", "malformedDemandEvidence", "replacementDemandStated", "replacementDemandEvidence", "derivedReframe"], "properties": {"malformedDemandExplained": {"type": "boolean"}, "malformedDemandEvidence": {"$ref": "#/$defs/evidence"}, "replacementDemandStated": {"type": "boolean"}, "replacementDemandEvidence": {"$ref": "#/$defs/evidence"}, "derivedReframe": {"type": "boolean"}}},
    "bridgeContact": {"type": "object", "additionalProperties": false, "required": ["bridgeId", "contactMode"], "properties": {"bridgeId": {"type": "string", "minLength": 1}, "contactMode": {"enum": ["supports", "attacks"]}}},
    "burden": {"type": "object", "additionalProperties": false, "required": ["contactedBridges", "derivedBurdenRelation"], "properties": {"contactedBridges": {"type": "array", "items": {"$ref": "#/$defs/bridgeContact"}}, "derivedBurdenRelation": {"enum": ["completes", "advances-central", "advances-sub-burden", "topical-peripheral", "unadopted-or-irrelevant"]}}},
    "annotation": {"type": "object", "additionalProperties": false, "required": ["moveId", "interactionMode", "targetPacketId", "primaryBurdenRouteId", "coveragePrimitives", "diagnosticPrimitives", "reframePrimitives", "burdenPrimitives", "coverageRationale", "mechanismRationale", "burdenRationale", "confidence"], "properties": {"moveId": {"type": "string", "minLength": 1}, "interactionMode": {"enum": ["constructive", "responsive"]}, "targetPacketId": {"type": ["string", "null"]}, "primaryBurdenRouteId": {"type": ["string", "null"]}, "coveragePrimitives": {"$ref": "#/$defs/coverage"}, "diagnosticPrimitives": {"$ref": "#/$defs/diagnostic"}, "reframePrimitives": {"$ref": "#/$defs/reframe"}, "burdenPrimitives": {"$ref": "#/$defs/burden"}, "coverageRationale": {"type": "string", "minLength": 40}, "mechanismRationale": {"type": "string", "minLength": 40}, "burdenRationale": {"type": "string", "minLength": 40}, "confidence": {"enum": ["high", "medium", "low"]}}},
    "audit": {"type": "object", "additionalProperties": false, "required": ["moveCount", "allInventoryLocksCopied", "evidenceOffsetErrors", "targetAxisApplicabilityErrors", "diagnosticObjectErrors", "derivationMismatches", "scoreFieldsPresent", "allMovesAnnotatedOnce"], "properties": {"moveCount": {"enum": [12, 16]}, "allInventoryLocksCopied": {"const": true}, "evidenceOffsetErrors": {"const": 0}, "targetAxisApplicabilityErrors": {"const": 0}, "diagnosticObjectErrors": {"const": 0}, "derivationMismatches": {"const": 0}, "scoreFieldsPresent": {"const": false}, "allMovesAnnotatedOnce": {"const": true}}}
  }
}
