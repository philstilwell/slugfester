{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester-production-canary-audio-attribution-adjudication",
  "title": "Slugfester production-canary isolated audio-attribution adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolId",
    "debateNumber",
    "debateId",
    "reviewerRole",
    "assessmentModel",
    "productionCanary",
    "stagingOnly",
    "isolation",
    "adjudications",
    "audit"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0-production-canary-audio-attribution-adjudication-output"
    },
    "protocolId": {
      "type": "string",
      "const": "assessment-production-canary-v1-audio-attribution-adjudication"
    },
    "debateNumber": {
      "type": "string",
      "const": "05"
    },
    "debateId": {
      "type": "string",
      "const": "dillahunty-ten-bruggencate-reasonable-god-2014"
    },
    "reviewerRole": {
      "type": "string",
      "const": "isolated-audio-attribution-adjudicator"
    },
    "assessmentModel": {
      "type": "string",
      "const": "5.6 Sol"
    },
    "productionCanary": {
      "type": "boolean",
      "const": true
    },
    "stagingOnly": {
      "type": "boolean",
      "const": true
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ratingsUnavailable",
        "scoresUnavailable",
        "legacyUnavailable",
        "otherDebatesUnavailable",
        "publicationProseUnavailable",
        "contaminationDetected"
      ],
      "properties": {
        "ratingsUnavailable": {
          "type": "boolean",
          "const": true
        },
        "scoresUnavailable": {
          "type": "boolean",
          "const": true
        },
        "legacyUnavailable": {
          "type": "boolean",
          "const": true
        },
        "otherDebatesUnavailable": {
          "type": "boolean",
          "const": true
        },
        "publicationProseUnavailable": {
          "type": "boolean",
          "const": true
        },
        "contaminationDetected": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "adjudications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moveId",
          "expectedSpeaker",
          "status",
          "authoringSpeaker",
          "corePropositionAuthoredByExpectedSpeaker",
          "mixedSpeakerSpan",
          "evidenceSegmentIndexes",
          "confidence",
          "rationale"
        ],
        "properties": {
          "moveId": {
            "type": "string",
            "const": "pro-move-07"
          },
          "expectedSpeaker": {
            "type": "string",
            "const": "Sye Ten Bruggencate"
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unresolved"
            ]
          },
          "authoringSpeaker": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "corePropositionAuthoredByExpectedSpeaker": {
            "type": "boolean"
          },
          "mixedSpeakerSpan": {
            "type": "boolean"
          },
          "evidenceSegmentIndexes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 20,
            "maxLength": 1200
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allDisputedMovesReviewed",
        "rawAudioDerivedSegmentsNotAltered",
        "calculatedScoreFieldsEmitted",
        "thresholdRelaxationUsed",
        "speakerRelabelingUsed",
        "manualOverrideUsed"
      ],
      "properties": {
        "allDisputedMovesReviewed": {
          "type": "boolean",
          "const": true
        },
        "rawAudioDerivedSegmentsNotAltered": {
          "type": "boolean",
          "const": true
        },
        "calculatedScoreFieldsEmitted": {
          "type": "boolean",
          "const": false
        },
        "thresholdRelaxationUsed": {
          "type": "boolean",
          "const": false
        },
        "speakerRelabelingUsed": {
          "type": "boolean",
          "const": false
        },
        "manualOverrideUsed": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
