{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester://assessment-production/multi-speaker-approximation-v1/inventory-audit",
  "title": "Slugfester multi-speaker independent inventory audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolId",
    "status",
    "debateNumber",
    "debateId",
    "reviewerRole",
    "assessmentModel",
    "reasoningEffort",
    "inventorySha256",
    "sourceLocks",
    "isolation",
    "findings",
    "correctionHistory",
    "verdict",
    "approvedForScoring",
    "audit"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0-multi-speaker-independent-inventory-audit" },
    "protocolId": { "const": "assessment-production-multi-speaker-approximation-v1" },
    "status": { "const": "complete-and-schema-valid" },
    "debateNumber": { "type": "string", "minLength": 1 },
    "debateId": { "type": "string", "minLength": 1 },
    "reviewerRole": { "const": "independent-score-blind-inventory-auditor" },
    "assessmentModel": { "const": "5.6 Sol" },
    "reasoningEffort": { "const": "low" },
    "inventorySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceLocks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcriptSha256", "eventsSha256"],
      "properties": {
        "transcriptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "eventsSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacyAssessmentsUnavailable",
        "calculatedTotalsUnavailable",
        "winnerLabelsUnavailable",
        "primaryJudgmentsUnavailable",
        "publicationProseUnavailable",
        "otherDebatesUnavailable",
        "contaminationDetected"
      ],
      "properties": {
        "legacyAssessmentsUnavailable": { "const": true },
        "calculatedTotalsUnavailable": { "const": true },
        "winnerLabelsUnavailable": { "const": true },
        "primaryJudgmentsUnavailable": { "const": true },
        "publicationProseUnavailable": { "const": true },
        "otherDebatesUnavailable": { "const": true },
        "contaminationDetected": { "const": false }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "category",
          "severity",
          "rationale",
          "relatedMoveIds",
          "correctionRequired",
          "resolved"
        ],
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "category": {
            "enum": [
              "omitted-load-bearing-move",
              "speaker-ownership",
              "side-assignment",
              "section-membership",
              "importance",
              "response-link",
              "adoption-link",
              "opportunity-coverage",
              "format-fitness"
            ]
          },
          "severity": { "enum": ["blocking", "material", "minor"] },
          "rationale": { "type": "string", "minLength": 40 },
          "relatedMoveIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "correctionRequired": { "type": "boolean" },
          "resolved": { "type": "boolean" }
        }
      }
    },
    "correctionHistory": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priorInventorySha256", "summary", "resolvedFindingIds"],
        "properties": {
          "priorInventorySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "summary": { "type": "string", "minLength": 40 },
          "resolvedFindingIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "verdict": { "enum": ["accept", "discussion-only"] },
    "approvedForScoring": { "type": "boolean" },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeTranscriptReviewed",
        "allLoadBearingMovesChecked",
        "speakerOwnershipChecked",
        "opportunityCoverageChecked",
        "formatFitnessChecked",
        "scoreBlind"
      ],
      "properties": {
        "completeTranscriptReviewed": { "const": true },
        "allLoadBearingMovesChecked": { "const": true },
        "speakerOwnershipChecked": { "const": true },
        "opportunityCoverageChecked": { "const": true },
        "formatFitnessChecked": { "const": true },
        "scoreBlind": { "const": true }
      }
    }
  }
}
