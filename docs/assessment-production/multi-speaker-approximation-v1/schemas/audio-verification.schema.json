{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester://assessment-production/multi-speaker-approximation-v1/audio-verification",
  "title": "Slugfester multi-speaker selected-move audio verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolId",
    "status",
    "debateNumber",
    "debateId",
    "inventorySha256",
    "verifications",
    "correctionsApplied",
    "audit"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0-multi-speaker-audio-verification" },
    "protocolId": { "const": "assessment-production-multi-speaker-approximation-v1" },
    "status": { "const": "complete-and-schema-valid" },
    "debateNumber": { "type": "string", "minLength": 1 },
    "debateId": { "type": "string", "minLength": 1 },
    "inventorySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verifications": {
      "type": "array",
      "minItems": 12,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moveId",
          "speaker",
          "speakerVerified",
          "startBoundaryVerified",
          "endBoundaryVerified",
          "crossTalkResolved",
          "quoteEligibleExactSpansVerified",
          "result",
          "notes"
        ],
        "properties": {
          "moveId": { "type": "string", "minLength": 1 },
          "speaker": { "type": "string", "minLength": 1 },
          "speakerVerified": { "const": true },
          "startBoundaryVerified": { "const": true },
          "endBoundaryVerified": { "const": true },
          "crossTalkResolved": { "const": true },
          "quoteEligibleExactSpansVerified": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "result": { "const": "confirmed" },
          "notes": { "type": "string", "minLength": 20 }
        }
      }
    },
    "correctionsApplied": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priorInventorySha256", "summary", "reaudited"],
        "properties": {
          "priorInventorySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "summary": { "type": "string", "minLength": 40 },
          "reaudited": { "const": true }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allSelectedMovesVerified",
        "allSpeakerHandoffsVerified",
        "allCrossTalkResolved",
        "allQuoteEligibleSpansVerified",
        "unresolvedAttributions"
      ],
      "properties": {
        "allSelectedMovesVerified": { "const": true },
        "allSpeakerHandoffsVerified": { "const": true },
        "allCrossTalkResolved": { "const": true },
        "allQuoteEligibleSpansVerified": { "const": true },
        "unresolvedAttributions": { "const": 0 }
      }
    }
  }
}
