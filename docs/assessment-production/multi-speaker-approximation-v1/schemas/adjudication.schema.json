{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester://assessment-production/multi-speaker-approximation-v1/adjudication",
  "title": "Slugfester multi-speaker approximation dispute adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolId",
    "status",
    "debateNumber",
    "debateId",
    "reviewerRole",
    "assessmentModel",
    "reasoningEffort",
    "isolation",
    "resolutions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0-multi-speaker-dispute-adjudication" },
    "protocolId": { "const": "assessment-production-multi-speaker-approximation-v1" },
    "status": { "const": "complete-and-schema-valid" },
    "debateNumber": { "type": "string", "minLength": 1 },
    "debateId": { "type": "string", "minLength": 1 },
    "reviewerRole": { "const": "isolated-dispute-only-adjudicator" },
    "assessmentModel": { "const": "5.6 Sol" },
    "reasoningEffort": { "const": "low" },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passIdentitiesUnavailable",
        "calculatedTotalsUnavailable",
        "winnerLabelsUnavailable",
        "publicationProseUnavailable",
        "otherDebatesUnavailable",
        "contaminationDetected"
      ],
      "properties": {
        "passIdentitiesUnavailable": { "const": true },
        "calculatedTotalsUnavailable": { "const": true },
        "winnerLabelsUnavailable": { "const": true },
        "publicationProseUnavailable": { "const": true },
        "otherDebatesUnavailable": { "const": true },
        "contaminationDetected": { "const": false }
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["disputeId", "selectedOption", "rationale"],
        "properties": {
          "disputeId": { "type": "string", "minLength": 1 },
          "selectedOption": { "enum": ["option-a", "option-b"] },
          "rationale": { "type": "string", "minLength": 40 }
        }
      }
    }
  }
}
