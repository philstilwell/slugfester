      "fields": [
        {
          "moveId": "con-fossils-contingency-unfalsifiability",
          "dimension": "logicalCoherence",
          "before": {
            "value": 83,
            "rationale": "Contingent survival explains incomplete fossils, and moving every gap to guidance risks insulating the claim from test."
          },
          "after": {
            "value": 66,
            "rationale": "The reply coherently separates whether evolution occurred from disputes about its tempo, then uses testability to challenge a generic design inference. Its contingency example shows that human emergence was not inevitable, but that fact alone does not establish that guidance was absent, so an important bridge in the overall inference remains underdeveloped."
          },
