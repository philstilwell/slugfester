    "candidates": [
      {
        "moveId": "pro-james-lawbreaking-points-to-preaching",
        "type": "fallacy",
        "label": "Argument from ignorance",
        "anonymousReviews": [
          {
            "decision": "rejected",
            "rationale": "Horn’s proposed offense is under-supported, but he cites the lawbreaker accusation, James’s reputed Torah observance, and stoning context while explicitly conceding speculation rather than claiming truth from non-disproof."
          },
          {
            "decision": "rejected",
            "rationale": "Horn acknowledges that Josephus does not specify the offense and labels his reconstruction speculative; he offers contextual lawbreaking and punishment considerations rather than treating silence alone as proof."
          }
        ]
      },
      {
        "moveId": "pro-probability-over-possibility",
        "type": "fallacy",
        "label": "Special pleading",
        "anonymousReviews": [
          {
            "decision": "rejected",
            "rationale": "Horn’s comparison from Trajan to Nero is historically vulnerable, yet he concedes nonuniform policy and offers a general procedural rationale rather than granting his side an unexplained exception."
          },
          {
            "decision": "rejected",
            "rationale": "Horn applies a comparative-probability standard to both sides and concedes nonuniform Roman policy; the disputed transfer from Trajan remains a weak analogy, not an unprincipled exemption."
          }
        ]
      },
      {
        "moveId": "pro-public-association-analogy",
        "type": "bias",
        "label": "Scope neglect",
        "anonymousReviews": [
          {
            "decision": "rejected",
            "rationale": "Horn explicitly presents the eleven associates as a hypothetical minimalist analogy and recognizes the need to establish ancient association; he does not erase the numerical or evidential differences."
          }
        ]
      },
      {
        "moveId": "pro-collective-acts-and-paul-evidence",
        "type": "bias",
        "label": "Scope neglect",
        "anonymousReviews": [
          {
            "decision": "rejected",
            "rationale": "The inference risks distributing collective grammar across every one of eleven people, but Horn expressly addresses the bounded group and offers two textual lines; overgeneralization is not clearly scale insensitivity."
          }
        ]
      },
      {
        "moveId": "pro-apostle-as-public-messenger",
        "type": "fallacy",
        "label": "Equivocation",
        "anonymousReviews": [
          {
            "decision": "rejected",
            "rationale": "Horn openly distinguishes apostle’s general messenger sense from its special eyewitness application to the eleven, so the inferential weakness is insufficient biographical support rather than a hidden meaning shift."
          }
        ]
      },
      {
        "moveId": "con-inference-stacking",
        "type": "fallacy",
        "label": "Argument from ignorance",
        "anonymousReviews": [
          {
            "decision": "rejected",
            "rationale": "Paulogia challenges several affirmative inferential links and withholds confidence about all eleven; he does not conclude they stopped preaching merely because later individual records are absent."
          }
        ]
      },
      {
        "moveId": "pro-two-lines-support-group-preaching",
        "type": "fallacy",
        "label": "Argument from ignorance",
        "anonymousReviews": [
          {
            "decision": "rejected",
            "rationale": "Horn says he lacks reason to doubt the group preached, but that remark follows affirmative Acts and First Corinthians evidence; the conclusion is not supported solely by Paulogia’s failure to disprove it."
          },
          {
            "decision": "rejected",
            "rationale": "Although Horn says he has no reason to doubt the claim, he first supplies Acts and First Corinthians as positive convergent evidence, so absence of disproof is not his sole support."
          }
        ]
      },
      {
        "moveId": "con-named-leaders-not-all-eleven",
        "type": "fallacy",
        "label": "Appeal to authority",
        "anonymousReviews": [
          {
            "decision": "rejected",
            "rationale": "Paulogia mentions McDowell and Allison while independently stating the missing person-specific evidence, and he qualifies what Allison was actually asked; scholarly status does not settle his conclusion."
          }
        ]
      },
      {
        "moveId": "pro-named-apostates-would-expose-abandonment",
        "type": "fallacy",
        "label": "Argument from ignorance",
        "anonymousReviews": [
          {
            "decision": "rejected",
            "rationale": "Horn relies partly on absent records of apostolic defection, but he supplies an expected-evidence argument from the community’s practice of naming defectors; selective preservation weakens rather than formalizes the inference."
          },
          {
            "decision": "rejected",
            "rationale": "Horn’s expectation rests on positive textual examples of named defectors and the prominence of original witnesses, making the silence inference contestable but not simply truth from failure to disprove."
          }
        ]
      },
      {
        "moveId": "pro-strongest-case-is-expected-suffering",
        "type": "fallacy",
        "label": "Appeal to authority",
        "anonymousReviews": [
          {
            "decision": "rejected",
            "rationale": "Horn invokes respected scholars and quotes Sanders, but he states Sanders may not endorse all apostles and treats scholarship as supporting context, not status that settles the disputed universal inference."
          },
          {
            "decision": "rejected",
            "rationale": "Horn quotes Sanders as evidence of a limited scholarly judgment and immediately concedes Sanders may not support all apostles, preventing the citation from functioning as status-based resolution."
          }
        ]
      },
      {
        "moveId": "con-minimal-sincere-experiences-scenario",
        "type": "bias",
        "label": "Subjective validation",
        "anonymousReviews": [
          {
            "decision": "rejected",
            "rationale": "Paulogia says the martyr argument’s collapse mattered to his deconversion, yet his personal history explains significance rather than evidential accuracy; the proposed scenario rests on an explicit hypothesis, not private resonance."
          },
          {
            "decision": "rejected",
            "rationale": "Paulogia reports the martyr argument’s importance to his deconversion after presenting the evidential scenario; that personal history explains motivation but is not offered as proof of the scenario."
          }
        ]
