### Ran Playwright code
```js
await (async (page) => {
  const width = page.viewportSize().width;
  const label = width === 390 ? 'mobile' : 'desktop';
  const check = (condition, message) => { if (!condition) throw new Error(message); };
  const cards = page.locator('article.argument');
  check(await cards.count() === 39, 'Expected all 39 locked cards');
  check((await cards.locator(':scope > p').allTextContents()).every(t => t.trim().length > 30), 'Empty argument description');
  check(await page.locator('a.tag.fallacy').count() === 2, 'Two adjudicated card tags');
  check(await page.getByRole('link', {name:'Appeal to authority', exact:true}).count() === 4, 'Card and overall links');
  check(!(await page.evaluate(() => document.documentElement.scrollWidth > innerWidth)), 'Horizontal overflow');
  check((await page.getByRole('heading', {level:1}).innerText()).includes('Matt Dillahunty vs Blake Giunta'), 'Title');
  const scope = page.getByRole('region', {name:'Source and assessment scope'});
  const scopeText = await scope.innerText();
  check(scopeText.includes('05:29–1:16:07') && scopeText.includes('Neither debater receives credit or penalty') && scopeText.includes('No direct listening'), 'Scope disclosure');
  await scope.scrollIntoViewIfNeeded();
  await page.screenshot({path:`output/playwright/debate-266/${label}-scope.png`});
  const summary = page.locator('details.ai-extension-accordion > summary');
  const details = page.locator('details.ai-extension-accordion');
  check(!await details.evaluate(el => el.open), 'AI default must be collapsed');
  await summary.scrollIntoViewIfNeeded();
  await page.screenshot({path:`output/playwright/debate-266/${label}-ai-closed.png`});
  await summary.click();
  check(await details.evaluate(el => el.open), 'AI pointer open');
  await summary.press('Enter');
  check(!await details.evaluate(el => el.open), 'AI Enter close');
  await summary.press('Space');
  check(await details.evaluate(el => el.open), 'AI Space open');
  await page.screenshot({path:`output/playwright/debate-266/${label}-ai-open.png`});
  await summary.click();
  const button = page.getByRole('button', {name:'Critique for Direct reply', exact:true}).first();
  await button.scrollIntoViewIfNeeded();
  await button.click();
  const tipId = await button.getAttribute('aria-describedby');
  const tip = page.locator(`[id="${tipId}"]`);
  await page.waitForFunction(id => { const el=document.getElementById(id); const s=getComputedStyle(el); return s.visibility==='visible' && Number(s.opacity)===1; }, tipId);
  const tipVisible = async () => await tip.evaluate(el => {const s=getComputedStyle(el);return s.visibility!=='hidden' && Number(s.opacity)>0 && s.display!=='none';});
  check(await tipVisible(), 'Critique pointer visible');
  await page.mouse.move(0,0);
  await button.focus();
  await button.press('Enter');
  check(await tipVisible(), 'Critique Enter/focus visible');
  await button.press('Space');
  check(await tipVisible(), 'Critique Space/focus visible');
  check(await button.evaluate(el=>el===document.activeElement), 'Critique focus retained');
  await page.screenshot({path:`output/playwright/debate-266/${label}-critique.png`});
  await summary.click({timeout:5000});
  check(await details.evaluate(el => el.open), 'Distant AI control not intercepted by critique');
  await summary.click();
  const portraits = await page.locator('img[src="/assets/caricatures/matt-dillahunty.webp"], img[src="/assets/caricatures/blake-giunta.webp"]').evaluateAll(images=>images.map(i=>({src:i.getAttribute('src'),loaded:i.complete&&i.naturalWidth>0})));
  check(portraits.every(p=>p.loaded), 'Participant portraits loaded');
  check(!(await page.evaluate(() => document.documentElement.scrollWidth > innerWidth)), 'Final horizontal overflow');
  console.log(JSON.stringify({status:'passed-debate-interactions',viewport:page.viewportSize(),cards:39,cardTags:2,overallLinks:2,scopeVisible:true,aiPointerEnterSpace:true,critiquePointerEnterSpaceFocus:true,distantControlUnintercepted:true,portraits,horizontalOverflow:false}));
}
)(page);
```
