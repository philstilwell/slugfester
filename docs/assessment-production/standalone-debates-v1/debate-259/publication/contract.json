    "con-attention-schema-and-first-person-method",
    "pro-field-ontology-and-single-subjectivity",
    "con-panpsychist-alternative",
    "pro-lawful-mind-and-perceptual-dashboard",
    "con-regularity-and-explanatory-gain",
    "pro-ontological-economy-and-mental-modulation",
    "con-dashboard-ontology-neutrality",
    "pro-matter-as-dissociative-appearance",
    "con-neural-correlation-demand",
    "pro-inferential-isolation-and-clinical-evidence",
    "con-minimal-dissociative-boundary",
    "pro-biology-as-dissociative-boundary",
    "con-clinical-to-cosmic-scope-gap",
    "pro-experience-without-metaconsciousness",
    "con-ordinary-perceptual-dissociations",
