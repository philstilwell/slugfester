      "pro": "{score:73,strengths:[3 strings],blunders:[3 {text,links:[]}]}",
      "con": "{score:73,strengths:[3 strings],blunders:[3 {text,links:[]}]}"
    },
    "logicalExtension": "For each side: finalArgument {thesis,premises:[5],conclusion,notice}; newArguments:[3 {title,text}]."
