await (async (page) => {
const cfg={"candidate":{"number":"288","id":"shermer-vandeweghe-jesus-miracles-2019","date":"2026-10-06","title":"Michael Shermer vs Luuk Vandeweghe — Are the Miracles of Jesus Unbelievable? (2019)","label":"Jesus’s Miracles","topicCategory":"resurrection-miracles","youtubeUrl":"https://www.youtube.com/watch?v=AgVCo5Jeq3U","duration":"1 hr 51 min","motion":"Are the miracles of Jesus unbelievable?","assessmentModel":"5.6 Sol","assessmentRubric":"Slugfester Reassessment Rubric v2","sourceNote":"This assessment covers both formal opening statements and rebuttals (approximately 6:56–1:11:59), plus both closing statements (1:49:07–1:58:23). The entire moderated discussion and audience Q&A, including both speakers’ answers and dependent replies, and the introductory montage and surrounding host remarks are excluded at the editor’s request. Neither speaker receives credit or penalty for excluded material. These scores assess the formal rounds and closings, not the complete recording. The complete public English automatic captions were reviewed; source wording was not independently audio-verified. Garbled names, numbers, negations and quotations were excluded as rating grounds, and selected arguments use their intelligible surrounding support. Featured quotations preserve complete source thoughts.","scoringNote":"Scores are AI-generated estimates of argumentative performance, rather than judgments about worldview truth; the separate AI Contribution does not affect these scores.","sides":{"pro":{"name":"Jesus’s miracles are unbelievable","speaker":"Michael Shermer","color":"teal"},"con":{"name":"Jesus’s miracles are historically credible","speaker":"Luuk Vandeweghe","color":"coral"}},"score":{"pro":82,"con":75,"winner":"pro"},"summary":"Shermer wins by pressing claim-specific evidence and comparative religious testimony, while Vandeweghe offers substantive but incompletely connected historical witness arguments.","quotes":{"pro":{"text":"given enough time the highly improbable will happen","context":"Shermer uses repeated opportunities and the law of large numbers to argue that striking coincidences can occur naturally, so low probability alone does not establish divine intervention."},"con":{"text":"they died for something they experienced publicly as adults","context":"Vandeweghe distinguishes the disciples’ alleged firsthand adult experiences from later zealots who sacrifice themselves for inherited teachings, making access rather than sincerity the key issue."}},"sections":[{"sectionId":"evidential-thresholds","title":"Probability, testimony, and the threshold for miracles","timebox":"9:18–1:02:35","score":{"pro":87,"con":71},"exchanges":[{"pro":{"ledgerMoveId":"pro-chance-events-need-no-divine-intervention","time":"9:18","score":84,"role":"Constructive","words":"Shermer argues that rare coincidences become expected across enormous numbers of opportunities, so apparent improbability by itself does not justify inferring any miraculous intervention.","critique":"Strongest feature: Shermer converts an intuitive coincidence into a frequency argument, emphasizing that enormous opportunity sets predict occasional astonishing outcomes without supernatural intervention and thereby directly challenges the inference from improbability to miracle. Principal limitation: The reasoning fits coincidences generated by many trials, but it does not establish that every reported healing, resurrection, or purposive event belongs to an adequately specified repeatable class with enough relevant opportunities. Live burden: Shermer must identify the comparison class and show that chance, misperception, or transmission plausibly explains the particular reports under dispute, while Vandeweghe still must demonstrate why those reports exceed ordinary probabilistic expectations. Locked score: 84 reflects a clear, accessible corrective to probability neglect whose general force is considerable, although its application to each historically specific miracle remains incompletely developed.","tags":[]},"con":{"ledgerMoveId":"con-extraordinary-evidence-is-offered","time":"1:01:42","score":71,"role":"Reply","words":"Vandeweghe accepts the need for extraordinary support and claims his early, multiple, costly witness evidence satisfies that elevated standard rather than merely resisting its application.","critique":"Strongest feature: Vandeweghe does not evade the heightened threshold; he explicitly claims to meet it through evidence presented in his opening, preserving the central comparative issue and preventing the slogan from deciding the debate before sources are assessed. Principal limitation: The rebuttal initially asserts extraordinariness more than it demonstrates it, and its diversion to atheists' alleged extraordinary beliefs neither strengthens Jesus evidence nor answers the claim-specific comparison between miracle and testimonial error. Live burden: Vandeweghe must show that early access, independence, public observability, and costly persistence jointly outweigh ordinary explanations, while Shermer must evaluate that cumulative case rather than repeating a threshold formula. Locked score: 71 credits correct engagement with the burden and an intelligible cumulative proposal, reduced for assertion, irrelevant countercomparison, and incomplete calibration of the offered evidence.","tags":[{"type":"fallacy","label":"Red herring","url":"https://logfall.com/fallacies/red-herring/","context":"Vandeweghe diverts from Jesus testimony to unrelated atheist beliefs about life, consciousness, and cosmology."}]}},{"pro":{"ledgerMoveId":"pro-comparative-evidence-over-miracle-testimony","time":"15:15","score":86,"role":"Constructive","words":"Shermer argues that mistaken or embellished testimony is more probable than a unique resurrection, so rational belief should follow the comparatively better-supported historical explanation.","critique":"Strongest feature: Shermer frames the dispute as a comparison between rival explanations, asking whether testimonial distortion is less extraordinary than one resurrection among the immense number of human deaths and thereby supplies a disciplined evidential threshold. Principal limitation: His numerical framing is deliberately broad and does not estimate the reliability, dependence, or historical proximity of the particular testimony, so it risks treating the evidence as generic storytelling before analyzing its alleged strengths. Live burden: Shermer must show that ordinary testimonial failure better explains this record, while Vandeweghe must establish that the source chain is sufficiently early, independent, informed, and resistant to distortion to reverse that comparison. Locked score: 86 recognizes a powerful burden-setting argument and clear explanatory contest, tempered by limited case-specific probability analysis.","tags":[]}},{"pro":{"ledgerMoveId":"pro-alien-story-tests-claim-specific-evidence","time":"51:56","score":90,"role":"Reply","words":"Shermer’s invented alien-abduction journey shows that accurate ordinary travel details do not transfer credibility to an extraordinary narrative addition without evidence specific to that remarkable claim.","critique":"Strongest feature: Shermer constructs a controlled example in which routes, companions, meals, and travel details can be accurate while an alien-abduction episode remains fabricated, sharply exposing the invalid transfer from mundane accuracy to extraordinary content. Principal limitation: The admitted invention demonstrates logical compatibility, not historical probability, and it does not incorporate Vandeweghe's claimed multiple witnesses, costly commitment, or public repetition, so the analogy cannot by itself model the complete Christian case. Live burden: Shermer must show that the Gospel evidence resembles the unsupported extraordinary insertion rather than the stronger access pattern alleged by Vandeweghe, who must establish those alleged differences independently. Locked score: 90 rewards an exceptionally clear, targeted rebuttal that separates source competence from claim-specific warrant, despite limits in its historical correspondence.","tags":[]}}]},{"sectionId":"historical-sources-and-memory","title":"Historical sources, authorship, and memory","timebox":"16:58–1:51:27","score":{"pro":82,"con":78},"exchanges":[{"pro":{"ledgerMoveId":"pro-memory-is-reconstructive","time":"16:58","score":82,"role":"Constructive","words":"Shermer argues that memory is continually edited rather than replayed like a recording, weakening confidence in miracle testimony preserved through recollection and repeated social retelling.","critique":"Strongest feature: Shermer identifies a concrete mechanism of error rather than merely alleging dishonesty, explaining that recollections are repeatedly reconstructed through later memories, photographs, and narration, which bears directly on eyewitness transmission. Principal limitation: The general fallibility of memory does not establish that central, repeated, life-shaping experiences are typically invented or reversed, and he offers no case-specific account of which Gospel miracle memories changed, when, or through what social process. Live burden: Shermer must connect reconstructive memory to material alteration of the relevant claims, while Vandeweghe must justify why central-event retention and communal repetition reliably preserve extraordinary content rather than only an event's broad outline. Locked score: 82 rewards a scientifically intelligible challenge with genuine relevance, but discounts its incomplete bridge from general psychology to these reports.","tags":[]},"con":{"ledgerMoveId":"con-luke-investigated-named-witnesses","time":"37:35","score":76,"role":"Constructive","words":"Vandeweghe portrays Luke as a careful traveling investigator who interviewed named participants, so their convergent firsthand testimony allegedly supports the historical credibility of Jesus’s miracles.","critique":"Strongest feature: Vandeweghe offers an identifiable transmission model rather than invoking anonymous tradition: a companion of Paul investigates available participants, names likely informants, and presents repeated miracle testimony amid personal exposure to Christian suffering. Principal limitation: The speech infers interviews from narrative names and traditional authorship without demonstrating individual source independence, exact testimony, or how Luke distinguished shared tradition from separate confirmation; the imagined presence at Peter's death is explicitly conjectural. Live burden: Vandeweghe must substantiate authorship, access, and independence sufficiently to make convergence evidential, while Shermer must address the resulting source chain rather than relying only on general memory fallibility. Locked score: 76 rewards a coherent historical mechanism and concrete investigatory claim, constrained by the distance between plausible reconstruction and established provenance for particular miracle reports.","tags":[]}},{"pro":{"ledgerMoveId":"pro-gospels-are-anonymously-attributed","time":"50:48","score":82,"role":"Reply","words":"Shermer argues that traditional Gospel names were later attached to originally anonymous works, undermining confident historical links to Luke, Peter, and their alleged direct eyewitness investigation.","critique":"Strongest feature: Shermer targets a load-bearing premise in Vandeweghe's case, because uncertainty about authorship weakens the claimed chains from Mark to Peter and from Luke to named eyewitness interviews rather than merely disputing peripheral details. Principal limitation: He largely appeals to the view of most scholars and proposed composition dates without presenting the internal, manuscript, or patristic evidence, leaving the assertion exposed to Vandeweghe's subsequent positive attribution argument. Live burden: Shermer must defend anonymity and explain what evidential weight remains even under uncertain authorship, while Vandeweghe must establish the traditional identities rather than presupposing them from titles or uniform later reception. Locked score: 82 reflects the objection's central relevance and potentially broad consequences, tempered by its abbreviated support within the formal speech.","tags":[{"type":"fallacy","label":"Appeal to authority","url":"https://logfall.com/fallacies/appeal-to-authority/","context":"Shermer relies on most biblical scholars to establish Gospel anonymity and the proposed composition sequence."}]},"con":{"ledgerMoveId":"con-luke-ordinary-accuracy-supports-historical-care","time":"40:21","score":75,"role":"Constructive","words":"Vandeweghe argues that Luke’s accurate geography and voyage details demonstrate meticulous historical practice, thereby increasing confidence in his careful investigation and reporting of miracle testimony.","critique":"Strongest feature: Vandeweghe supplies positive calibration from ordinary details, arguing that correct geographical placement and credible travel narration show an author attentive to checkable features rather than indifferent to historical accuracy. Principal limitation: Accuracy about islands, routes, winds, and shipwreck duration does not by itself validate supernatural episodes, because a writer can preserve mundane facts while accepting mistaken extraordinary testimony, and the cited checks are not connected to miracle sources. Live burden: Vandeweghe must explain why demonstrated care transfers across evidential categories and how Luke verified miracles; Shermer may grant ordinary competence while withholding the supernatural inference unless that transfer is independently justified. Locked score: 75 recognizes relevant evidence for authorial care and a cumulative source case, discounted because the inference from ordinary accuracy to miraculous truth remains substantially indirect.","tags":[]}},{"pro":{"ledgerMoveId":"pro-closing-truth-claims-require-different-tests","time":"1:49:25","score":83,"role":"Constructive","words":"Shermer distinguishes countable facts, preferences, altered experiences, politics, and religious claims, arguing that each epistemic category requires an appropriate method of evaluation and public verification.","critique":"Strongest feature: Shermer gives the closing a useful epistemic framework, showing why subjective conviction, aesthetic preference, political settlement, empirical fact, and private experience cannot all inherit the same standards of public verification. Principal limitation: The taxonomy remains illustrative and somewhat porous, because historical claims about a resurrection are neither mere preference nor directly repeatable experiment, and categorizing them does not determine what testimonial evidence could rationally establish. Live burden: Shermer must articulate a principled test for singular historical events and apply it without classifying the disputed conclusion by assumption, while Vandeweghe must show that his evidence meets that test. Locked score: 83 recognizes clear conceptual organization and direct relevance to believability, tempered by the framework's incomplete treatment of historical inference.","tags":[]},"con":{"ledgerMoveId":"con-gospel-identity-has-internal-and-external-support","time":"1:03:56","score":82,"role":"Reply","words":"Vandeweghe uses distinctive geographical language and uniform early attribution to defend traditional Gospel identities, restoring his claimed historical links between the written accounts and eyewitness sources.","critique":"Strongest feature: Vandeweghe supplies both internal and external reasons: differing geographical language allegedly fits the authors' backgrounds, while uniform manuscript and early church attribution challenges the expectation that anonymous works would acquire stable names without dispute. Principal limitation: The linguistic example is suggestive rather than identifying, and uniform surviving attribution may reflect an early naming convention rather than original authorship; the response also does not present dates or independent chains for the external evidence. Live burden: Vandeweghe must show that these indicators discriminate traditional authorship from plausible alternatives and then connect authors to specific witnesses, while Shermer must explain the uniformity his anonymity claim faces. Locked score: 82 recognizes a substantive, responsive defense using convergent evidence, constrained by the limited demonstration of how strongly either indicator identifies the proposed authors.","tags":[]}},{"con":{"ledgerMoveId":"con-memory-retains-central-life-changing-events","time":"1:08:54","score":79,"role":"Reply","words":"Vandeweghe argues that memory errors typically concern peripheral details, whereas meaningful identity-forming experiences remain stable enough to preserve the central content of reported miracle encounters.","critique":"Strongest feature: Vandeweghe directly narrows Shermer's general memory objection, distinguishing ordinary mistakes about names, lighting, and dates from wholesale forgetting of a spouse or transformative public event and citing stable overall recall percentages. Principal limitation: Short-term retention after a vivid event does not establish reliable transmission across the decades relevant to Gospel formation, while stable central gist can preserve an experience without preserving its causal interpretation, supernatural attribution, or surrounding evidential detail. Live burden: Vandeweghe must show that central retention preserves the evidential content required for miracles rather than merely memorable experiences, while Shermer must identify plausible distortion affecting that content. Locked score: 79 rewards a relevant empirical and conceptual reply that prevents overgeneralizing memory fallibility, reduced because durable salience and accurate extraordinary interpretation remain distinct.","tags":[{"type":"bias","label":"Scope neglect","url":"https://cogbias.site/biases/scope-neglect/","context":"Vandeweghe extrapolates stable three-month recall to miracle memories transmitted across the much longer Gospel period."}]}}]},{"sectionId":"witness-sincerity-and-access","title":"Witness sincerity, access, and martyrdom","timebox":"30:07–1:03:56","score":{"pro":80,"con":78},"exchanges":[{"pro":{"ledgerMoveId":"pro-martyrdom-shows-conviction-not-truth","time":"54:10","score":84,"role":"Reply","words":"Shermer argues that people across many religions and political ideologies die for false beliefs, so extreme suffering demonstrates conviction but cannot independently establish factual truth.","critique":"Strongest feature: Shermer supplies a broad range of religious and secular counterexamples, decisively separating willingness to suffer from truth and blocking any simple inference that costly devotion authenticates the proposition inspiring it. Principal limitation: The examples mostly involve inherited ideology rather than alleged firsthand adult experience, so they answer bare sincerity more fully than Vandeweghe's refined claim about witnesses positioned to know whether publicly experienced events occurred. Live burden: Shermer must explain why the early disciples' access was no better than later zealots' access or challenge that historical premise, while Vandeweghe must prove which martyrs actually possessed and died for first-person knowledge. Locked score: 84 recognizes a strong and necessary logical correction, with a deduction because the rebuttal does not completely meet the opponent's access-based qualification.","tags":[]},"con":{"ledgerMoveId":"con-early-christian-costly-sincerity","time":"30:07","score":72,"role":"Constructive","words":"Vandeweghe argues that early Christians endured severe persecution without retracting testimony, making deliberate fabrication less plausible and supporting their sincere conviction about Jesus’s miracles.","critique":"Strongest feature: Vandeweghe links costly persistence to a defensible conclusion about sincerity, using proximity and refusal to recant as evidence that early adherents did not casually invent their proclamation. Principal limitation: The account moves loosely among direct witnesses, people taught by witnesses, and later Christians, so suffering can demonstrate commitment without establishing personal access to a miracle or the truth of the underlying interpretation. Live burden: Vandeweghe must identify which persecuted people possessed first-person knowledge, specify the miracle testimony each maintained, and establish that truthful recantation of that testimony could actually have prevented punishment. Locked score: 72 credits a plausible sincerity argument with real explanatory pressure, reduced because the evidential chain from generalized persecution to informed eyewitness confirmation is insufficiently differentiated.","tags":[]}},{"pro":{"ledgerMoveId":"pro-informed-religious-disagreement","time":"59:12","score":73,"role":"Constructive","words":"Shermer argues that well-informed Jews reject Christian evidence, indicating that resurrection belief is not publicly compelling knowledge produced by shared historical evidence and reasoning alone.","critique":"Strongest feature: Shermer invokes knowledgeable disagreement among people who share much of the scriptural and monotheistic background, challenging the suggestion that informed exposure to the evidence naturally yields Christian assent and supporting his distinction between faith and public knowledge. Principal limitation: Persistent expert disagreement can reflect prior commitments, interpretive standards, or asymmetric evidence without showing that neither side has better reasons, so nonconversion is not itself an adjudication of the historical case. Live burden: Shermer must connect disagreement to identifiable evidential underdetermination, while Vandeweghe must explain why his evidence remains compelling despite informed dissent rather than dismissing dissenters as unaware. Locked score: 73 recognizes a relevant epistemic caution and burden check, restrained because sociological disagreement alone has limited power to determine the truth or quality of reasons.","tags":[{"type":"fallacy","label":"Argument from ignorance","url":"https://logfall.com/fallacies/argument-from-ignorance/","context":"Shermer infers inadequate Christian arguments from informed Jews’ nonconversion and the absence of universal Christian assent."}]},"con":{"ledgerMoveId":"con-peter-source-and-first-person-access","time":"34:14","score":76,"role":"Constructive","words":"Vandeweghe links Mark’s miracle-heavy narrative to Peter, whose inner-circle access, ordinary practical knowledge, and costly death allegedly support informed testimony rather than credulous inheritance.","critique":"Strongest feature: Vandeweghe improves on generic martyrdom by combining an asserted source connection, Peter's close participation, recognition of death and disability, unflattering portrayal, and costly persistence into a cumulative access argument. Principal limitation: Several indispensable links are asserted rather than demonstrated within the speech, especially Mark's dependence on Peter, the precise circumstances of Peter's death, and whether recanting the miracle testimony would have prevented it. Live burden: Vandeweghe must establish Mark's dependence on Peter, Peter's firsthand access to the reported miracles, and circumstances in which Peter's death specifically tested recantable eyewitness testimony rather than general Christian allegiance. Locked score: 76 acknowledges a better argument than bare sincerity, but the historical connectors carrying it from narrative portrayal to verified eyewitness warrant remain contested and under-supported.","tags":[]}},{"con":{"ledgerMoveId":"con-james-family-access-and-costly-belief","time":"42:52","score":74,"role":"Constructive","words":"Vandeweghe argues that James’s familial knowledge, prior skepticism, changed worship, and fatal persistence make both deliberate deception and simple ignorance unlikely explanations of his belief.","critique":"Strongest feature: Vandeweghe combines close access with an alleged conversion from skepticism and willingness to suffer, making James more probative than a distant believer who merely inherited a religious tradition. Principal limitation: Knowing a sibling's character does not provide direct access to every public miracle or establish resurrection, and the speech compresses claims about James's prior attitude, death, and opportunity to recant without independently supporting their connection. Live burden: Vandeweghe must establish what James personally observed, how his alleged movement from skepticism bears on those observations, and why his death specifically tested denial of that knowledge rather than his broader religious leadership or allegiance. Locked score: 74 credits a potentially strong access-based example, reduced because family familiarity and later commitment do not yet establish the decisive supernatural events.","tags":[]}},{"con":{"ledgerMoveId":"con-first-person-experience-differs-from-inherited-belief","time":"1:02:35","score":88,"role":"Reply","words":"Vandeweghe distinguishes disciples allegedly dying for public adult experiences from later zealots dying for inherited teachings, preserving an epistemically relevant argument from knowledgeable martyrdom.","critique":"Strongest feature: Vandeweghe precisely identifies why Shermer's martyr examples need not be parallel: inherited believers can be sincerely mistaken about remote teachings, whereas adults who publicly experienced repeated events would allegedly know whether the foundational occurrence was fabricated. Principal limitation: The distinction is powerful only if the relevant disciples actually had the claimed experiences, independently reported them, and faced death contingent on recanting that testimony; those historical connectors remain asserted more than established in this reply. Live burden: Vandeweghe must document access and the testimonial stakes of persecution, while Shermer must challenge those premises or supply mechanisms such as misinterpretation and memory that operate even on firsthand experience. Locked score: 88 rewards the debate's strongest focused reply, which repairs a crucial category error while remaining conditional on contested history.","tags":[]}}]},{"sectionId":"comparative-miracle-traditions","title":"Competing miracle traditions and hostile testimony","timebox":"17:43–59:17","score":{"pro":76,"con":76},"exchanges":[{"pro":{"ledgerMoveId":"pro-apollonius-parallel","time":"17:43","score":76,"role":"Constructive","words":"Shermer presents Apollonius as a contemporaneous miracle-working divine figure whose later biography resembles Jesus traditions, thereby challenging claims that Christian miracle narratives are culturally unique.","critique":"Strongest feature: Shermer makes comparative skepticism concrete by initially presenting a Jesus-like biography and then revealing Apollonius, illustrating how familiar religious motifs can make a rival miracle worker sound similarly compelling. Principal limitation: The resemblance establishes neither literary dependence nor evidential parity, because the argument does not initially compare source dates, number of sources, authorial incentives, or proximity to alleged witnesses, precisely the dimensions Vandeweghe later contests. Live burden: Shermer must show that the parallel reaches the evidence-bearing structure rather than merely narrative motifs, while Vandeweghe must substantiate his claimed chronological and testimonial advantages without assuming Christian sources are reliable. Locked score: 76 credits a memorable comparator that punctures uniqueness intuitions, while recognizing that its force substantially depends on an underdeveloped equivalence between two historical records.","tags":[]},"con":{"ledgerMoveId":"con-hostile-sorcery-testimony","time":"45:27","score":68,"role":"Constructive","words":"Vandeweghe argues that hostile Jewish attribution of Jesus’s acts to sorcery concedes unusual public power, independently corroborating an early reputation for actions understood as miraculous.","critique":"Strongest feature: Vandeweghe exploits adverse testimony rather than friendly proclamation, reasoning that opponents who explain reported acts as sorcery may corroborate that a reputation could not simply be ignored. Principal limitation: A hostile tradition about sorcery can attest accusation or later reputation without verifying a supernatural event, and the speech does not establish the text's date, independence, transmission, or the inference that its wording necessarily concedes real power. Live burden: Vandeweghe must date the hostile tradition, establish its independence from Christian reporting, and show that sorcery language records adversarial access to public events rather than a later polemical repetition of circulating claims. Locked score: 68 recognizes a legitimate adverse-source strategy with some cumulative value, but the gap between hostile characterization and reliable miracle confirmation remains large and insufficiently defended.","tags":[]}},{"pro":{"ledgerMoveId":"pro-mormon-witness-comparator","time":"22:11","score":80,"role":"Constructive","words":"Shermer uses Joseph Smith’s claimed plates and eleven attesting witnesses to argue that even formally documented religious testimony does not make an extraordinary supernatural story credible.","critique":"Strongest feature: Shermer chooses a comparator with named signatories and a developed testimony tradition, forcing listeners who reject Mormon claims to explain why structurally similar witness language should carry greater weight for Christian miracles. Principal limitation: He emphasizes the apparent absurdity of the narrative without first comparing the witnesses' perceptual access, independence, later conduct, textual history, or the disputed meaning of seeing, leaving room for Vandeweghe's detailed disanalogy. Live burden: Shermer must show that the Mormon record matches the relevant epistemic features rather than merely containing testimony, while Vandeweghe must establish that his alleged differences genuinely increase reliability instead of relying on character attacks. Locked score: 80 rewards a sharp consistency test with recognizable evidential structure, while withholding higher credit because the comparison needs closer control of important differences.","tags":[]},"con":{"ledgerMoveId":"con-apollonius-evidence-is-later-and-interested","time":"47:40","score":83,"role":"Reply","words":"Vandeweghe argues that Apollonius rests on one substantially later commissioned source, so the apparent narrative parallel lacks Christianity’s claimed early, multiple, and costly evidential basis.","critique":"Strongest feature: Vandeweghe directly attacks the comparator on evidentially relevant dimensions, contrasting a single source written roughly a century and a half later and under interested patronage with the earlier, plural Christian record he has defended. Principal limitation: Showing that Apollonius is weaker does not independently prove Christian miracles, and the response depends on assertions about dating, commissioning, and source plurality whose precise support is not developed during the formal exchange. Live burden: Vandeweghe must validate both sides of the comparison and then show that Christianity's relative advantage crosses a credibility threshold, while Shermer can preserve his broader comparator argument by identifying common transmission mechanisms despite unequal records. Locked score: 83 rewards a focused and forceful disanalogy that meets Shermer's example directly, while reserving judgment on the positive miracle inference.","tags":[]}},{"pro":{"ledgerMoveId":"pro-fatima-mass-witness-comparator","time":"25:43","score":76,"role":"Constructive","words":"Shermer cites the reported mass vision at Fatima to test whether Christians consistently accept miracle claims supported by crowds far larger than alleged resurrection-witness groups.","critique":"Strongest feature: Shermer turns audience size into a consistency challenge, contrasting the familiar appeal to hundreds of resurrection witnesses with a much larger reported gathering around a Marian solar event that many listeners presumably reject. Principal limitation: A crowd count by itself does not establish what each observer perceived, whether reports were independent, or whether the event and interpretation match resurrection testimony, and the formal speech does not analyze those evidential details. Live burden: Shermer must establish relevant similarity beyond numerical scale, while Vandeweghe must explain which source, access, and phenomenon differences justify accepting one testimonial tradition while rejecting the comparator. Locked score: 76 recognizes an effective pressure test against selective confidence, but its evidential comparison remains too coarse to determine whether the traditions are genuinely analogous.","tags":[]},"con":{"ledgerMoveId":"con-joseph-smith-witnesses-and-character-disanalogy","time":"49:10","score":76,"role":"Reply","words":"Vandeweghe argues that spiritual sight, witness conflict, and deception alleged against Joseph Smith make the Mormon testimony materially weaker than his proposed Christian eyewitness case.","critique":"Strongest feature: Vandeweghe responds to the named-witness comparator with specific differences, including a witness's qualified mode of seeing, later conflict among principals, and conduct offered as evidence against Joseph Smith's honesty and judgment. Principal limitation: Character allegations against Smith do not resolve every witness's sincerity or experience, and the reply does not systematically compare document production, independence, recantation, perceptual access, or the quality of the Christian evidence under the same standards. Live burden: Vandeweghe must show that the identified defects explain the Mormon testimony while demonstrating that analogous defects are absent from his own source chain; Shermer must defend the comparison at that finer level. Locked score: 76 credits a concrete rebuttal that prevents facile equivalence, limited by selective comparison and overreliance on personal discrediting.","tags":[]}},{"pro":{"ledgerMoveId":"pro-islamic-miracle-tradition-comparator","time":"57:06","score":72,"role":"Constructive","words":"Shermer catalogs miracles attributed to Muhammad and argues that large, sincere religious traditions can sustain extraordinary claims that Christians nevertheless reject as historically unbelievable.","critique":"Strongest feature: Shermer presents numerous concrete miracle reports within a major living religion, forcing consistency about eyewitness language, documentary attestation, and mass belief instead of allowing Christian familiarity to substitute for comparative evaluation. Principal limitation: The catalogue does not compare source dates, textual independence, witness access, or historical development, and declaring the traditions indistinguishable from an imagined outsider's perspective assumes the evidential equivalence that the debate must establish. Live burden: Shermer must demonstrate similarity in the features that govern reliability, while Vandeweghe must articulate and support non-question-begging differences between the Islamic reports and his Christian evidence. Locked score: 72 credits a useful antidote to parochial confidence and a genuine comparative burden, reduced because rhetorical abundance substitutes for a disciplined source-by-source analysis.","tags":[]}}]},{"sectionId":"mythology-and-closing-epistemology","title":"Mythology, historical meaning, and closing epistemology","timebox":"20:34–1:57:20","score":{"pro":80,"con":73},"exchanges":[{"pro":{"ledgerMoveId":"pro-ancient-redeemer-patterns","time":"20:34","score":72,"role":"Constructive","words":"Shermer compares Jesus narratives with Dionysus, Osiris, and recurring hero-redemption patterns, suggesting familiar ancient mythology can generate apparently distinctive stories of supernatural salvation.","critique":"Strongest feature: Shermer broadens the comparator set beyond one disputed figure, locating virgin birth, resurrection, divine sonship, sacramental imagery, and redemption within recurring cultural patterns that make independent supernatural confirmation less automatic. Principal limitation: The listed similarities vary in precision and historical relation, and thematic recurrence alone cannot establish that Gospel authors borrowed, transformed, or fabricated the particular claims rather than recording events later interpreted through shared human motifs. Live burden: Shermer must demonstrate historically relevant transmission or a sufficiently close explanatory pattern, while Vandeweghe must show why Jewish resistance to pagan influence and claimed historical anchoring defeats more indirect cultural convergence. Locked score: 72 reflects useful comparative breadth and an intelligible naturalistic hypothesis, reduced because the argument catalogs parallels more effectively than it proves genealogy or evidential equivalence.","tags":[]},"con":{"ledgerMoveId":"con-jewish-context-resists-pagan-borrowing","time":"1:06:09","score":80,"role":"Reply","words":"Vandeweghe argues that Palestinian Jewish authors resisted Hellenistic religion and saturated their writings with Hebrew scripture, making direct pagan borrowing a historically unlikely explanation of Gospel parallels.","critique":"Strongest feature: Vandeweghe replaces a bare denial with a cultural mechanism, pointing to scriptural saturation, hostility toward idolatrous imagery, and resistance to Hellenistic influence as reasons Gospel authors would not casually import pagan divine-hero mythology. Principal limitation: Cultural resistance does not exclude indirect influence, polemical adaptation, or recurring motifs without conscious borrowing, and the argument treats Palestinian Judaism too uniformly while offering no direct analysis of transmission for Shermer's particular parallels. Live burden: Vandeweghe must connect the authors and motifs to the resistant context strongly enough to defeat plausible diffusion or convergence, while Shermer must specify an actual route or independent generative mechanism. Locked score: 80 rewards historically relevant rebuttal and a credible obstacle to simple borrowing, tempered because it does not exhaust subtler accounts of similarity.","tags":[{"type":"fallacy","label":"Argument from ignorance","url":"https://logfall.com/fallacies/argument-from-ignorance/","context":"Vandeweghe argues that zero evidence of pagan influence helps show the Gospel writers did not borrow mythology."}]}},{"pro":{"ledgerMoveId":"pro-resurrection-remains-faith-not-public-knowledge","time":"1:51:25","score":85,"role":"Reply","words":"Shermer concludes that resurrection and atonement remain faith commitments because the offered historical evidence does not command assent across informed religious perspectives familiar with the arguments.","critique":"Strongest feature: Shermer grants ordinary historical claims about Jesus while isolating the resurrection and salvific interpretation as the decisive extraordinary step, then connects continuing informed disagreement to his distinction between commitment and publicly checkable knowledge. Principal limitation: The absence of universal informed assent does not prove that evidence is inadequate, and calling atonement unverifiable can obscure the more concrete resurrection claim, which is at least presented as a historical proposition open to comparative inference. Live burden: Shermer must show why the specific testimony fails standards appropriate to singular history, while Vandeweghe must demonstrate that the record warrants more than tradition-dependent belief. Locked score: 85 rewards a disciplined closing that preserves distinctions and squarely answers the motion, with a deduction for leaning on disagreement as a proxy for evidential adjudication.","tags":[]},"con":{"ledgerMoveId":"con-mythic-parallels-can-express-fulfilled-hope","time":"1:07:25","score":67,"role":"Reply","words":"Vandeweghe argues that recurring redemption myths may express universal human hopes fulfilled historically in Jesus, so thematic similarity need not imply fabrication, dependence, or pagan borrowing.","critique":"Strongest feature: Vandeweghe exposes an underdetermination in the parallel argument: narrative resemblance can be interpreted as anticipation of a historical fulfillment rather than evidence of copying, so thematic overlap alone cannot settle historicity. Principal limitation: The fulfilled-hope interpretation is compatible with the evidence but independently unsupported within the debate, and invoking universal longing does not show that Jesus uniquely instantiated the pattern or that miracle reports are historically reliable. Live burden: Vandeweghe must supply evidence that moves from symbolic resonance to actual fulfillment, while Shermer must show why natural cultural recurrence or borrowing better explains the shared motifs. Locked score: 67 credits a philosophically coherent alternative interpretation that blocks an automatic inference, but its positive evidential contribution remains modest and largely theological rather than historical.","tags":[]}},{"con":{"ledgerMoveId":"con-closing-evidence-supports-commitment","time":"1:56:10","score":72,"role":"Constructive","words":"Vandeweghe concludes that early, costly, purported eyewitness evidence makes commitment to Jesus rational despite real risk, giving the miracles existential significance grounded in historical claims.","critique":"Strongest feature: Vandeweghe gathers his case into a practical conclusion: the earliest associates allegedly accepted hardship because of what they saw, so commitment can be anchored in history rather than presented as arbitrary preference. Principal limitation: The closing shifts from evidence to the value of decisive commitment, but the hallway metaphor cannot strengthen disputed source claims, and costly belief still requires the access and reliability premises challenged throughout the debate. Live burden: Vandeweghe must show that the retained source, access, transmission, and costly-witness evidence is historically connected strongly enough to justify commitment before the hallway analogy can supply any practical consequence. Locked score: 72 credits a clear synthesis and meaningful practical consequence, reduced because rhetorical exhortation occupies space that could have closed unresolved historical links.","tags":[]}}]}],"overall":{"pro":{"score":82,"strengths":["He consistently compares miracle explanations with ordinary failures of memory, testimony, and transmission.","The invented alien account sharply separates mundane narrative accuracy from support for an extraordinary addition.","His cross-religious comparisons expose selective confidence and keep evidential standards consistent across traditions.","The closing distinguishes historical, experiential, and faith claims while directly answering the motion."],"blunders":[{"text":"Several religious comparators are catalogued without establishing equal source quality, independence, proximity, or witness access.","links":[]},{"text":"The appeal to informed disagreement sometimes substitutes persistent nonacceptance for direct adjudication of the historical evidence.","links":[]}]},"con":{"score":75,"strengths":["He distinguishes sincere inherited belief from alleged firsthand adult experience, directly improving the martyrdom argument.","His Gospel-authorship reply offers both internal fit and uniform external attribution rather than mere traditional assertion.","He answers the Apollonius and Mormon comparisons with concrete evidential disanalogies instead of dismissing them.","His cumulative case connects source care, witness access, costly commitment, and hostile testimony."],"blunders":[{"text":"The case repeatedly compresses contested authorship, eyewitness access, persecution circumstances, and recantation into asserted historical chains.","links":[]},{"text":"Ordinary geographical accuracy and costly conviction are asked to carry more weight than they can provide for supernatural truth.","links":[]}]}},"logicalExtension":{"pro":{"finalArgument":{"thesis":"Miracle testimony becomes believable only when its source structure makes ordinary distortion less plausible than the extraordinary event reported.","premises":["Rare events and vivid coincidences are expected across sufficiently many opportunities, so improbability alone cannot identify supernatural agency.","Accurate ordinary details can coexist with fabricated extraordinary claims, making claim-specific corroboration essential rather than optional.","Memory preserves meaningful gist better than peripheral detail but can still reshape interpretation, causation, and supernatural significance.","Competing religions contain sincere witnesses, costly commitments, and miracle traditions, so those features require calibrated comparison rather than selective acceptance.","The surviving case leaves authorship, independence, firsthand access, and persecution-for-recantable-testimony sufficiently contested to sustain ordinary alternatives."],"conclusion":"Because the formal evidence does not make ordinary testimonial development less plausible than miracle, Jesus’s miracles remain unbelievable as publicly warranted historical claims."},"newArguments":[{"title":"Discriminating Evidence Test","text":"Evidence supports a miracle only insofar as it is appreciably more expected if the miracle occurred than if sincere people experienced coincidence, ambiguous events, memory reconstruction, or inherited tradition. Cost, vividness, and narrative detail can arise under both possibilities. The debate therefore needs features that discriminate between them: demonstrably independent reports, secured firsthand access, stable early wording, and circumstances in which a knowledgeable witness could expose fabrication. Without that likelihood comparison, accumulating emotionally forceful but nondiscriminating facts creates confidence without proportionate evidential gain."},{"title":"Comparator Symmetry","text":"A consistent method should be stated before naming the religion under assessment. Apply the same tests for dating, independence, sensory access, transmission, recantation, and alternative explanation to Christian, Mormon, Islamic, Marian, and ancient pagan reports. If a criterion is relaxed only for a familiar tradition, the resulting confidence reflects prior allegiance rather than evidential advantage. This symmetry does not imply that all traditions are equal; it specifies what must be measured for a defensible claim that one tradition is evidentially superior."},{"title":"Gist Interpretation Gap","text":"Even durable memory of a life-changing episode does not automatically preserve its correct explanation. Witnesses may remember that a crowd gathered, a sick person improved, or a leader was later believed alive while disagreeing about causation, timing, identity, and supernatural meaning. Thus the relevant question is not whether central experiences are forgotten wholesale, but whether the inference from remembered occurrence to suspension of natural regularity survived independent checking. That gap remains even when witnesses are honest and deeply transformed."}]},"con":{"finalArgument":{"thesis":"Jesus’s miracle reports become historically credible when multiple early source features jointly resist fabrication, inherited error, and loose mythic comparison.","premises":["The relevant disciples are presented as adults with direct access to repeated public events, unlike later devotees of inherited teachings.","Traditional Gospel identities receive convergent support from internal linguistic fit and uniform external attribution rather than unsupported titles alone.","Luke’s accuracy on checkable ordinary matters supplies limited calibration for careful investigation, even though it cannot independently prove miracles.","Costly persistence is evidential when tied specifically to knowledgeable witnesses whose testimony, rather than remote doctrine, created their exposure.","Rival traditions lose comparative force when their sources are substantially later, interested, qualified, dependent, or disconnected from firsthand public access."],"conclusion":"Taken cumulatively, these features can make informed testimony a better explanation than wholesale invention, provided the disputed source and persecution links are historically secured."},"newArguments":[{"title":"Convergent Chain","text":"No single fact must prove a miracle. Authorship evidence, ordinary accuracy, named-source access, hostile acknowledgment, public-event claims, and costly persistence can instead form a chain whose links constrain different error theories. Fabrication predicts weak sincerity; inherited legend predicts distance from firsthand witnesses; private hallucination predicts limited public convergence; careless transmission predicts instability and ordinary inaccuracies. The historical case strengthens when the same record performs better than these alternatives across independent dimensions, though every link must be established rather than bundled by assertion."},{"title":"Access Weighted Sacrifice","text":"Sacrifice should receive weight in proportion to a person's opportunity to know and the specificity of what punishment tests. A late believer's death shows conviction, while an original participant's avoidable punishment for a recantable eyewitness claim can also bear on honesty. This framework answers Shermer's catalogue without claiming that martyrs cannot be mistaken. It asks separately whether Peter, James, or another witness observed the relevant event, understood the alternatives, maintained the same claim, and could have reduced danger by truthfully denying it."},{"title":"Asymmetric Comparator Burden","text":"A rival miracle story rebuts the Christian case only when it matches the features doing evidential work. Narrative resemblance is insufficient if one account is late, singular, commissioned, or based on qualified spiritual perception while another is early, multiple, and connected to public participants. The defender need not prove every rival false; the task is to show why the same reliability criteria yield different results. This converts comparative religion from a rhetorical catalogue into a structured contest over provenance, independence, access, and corrective feedback."}]}}},"origin":"http://127.0.0.1:4181","prefix":"debate-288-avatar","screenshots":true,"screenshotDirectory":"output/playwright","requiredReaderDisclosure":"This assessment covers both formal opening statements and rebuttals (approximately 6:56–1:11:59), plus both closing statements (1:49:07–1:58:23). The entire moderated discussion and audience Q&A, including both speakers’ answers and dependent replies, and the introductory montage and surrounding host remarks are excluded at the editor’s request. Neither speaker receives credit or penalty for excluded material. These scores assess the formal rounds and closings, not the complete recording.","scopeCases":[{"id":"licona-carrier-resurrection-formal-rounds-2004","number":"255","notice":"Only the formal debate rounds (5:10–1:38:23) are assessed. The subsequent question-and-answer session, including moderator-authored challenges and both speakers' replies, is excluded; neither speaker receives credit or penalties for that material. These scores are not an assessment of the complete recording."},{"id":"aron-ra-jones-christianity-dangerous-formal-rounds-2019","number":"256","notice":"Only the opening statements and cross-examination (1:59–1:27:22) are assessed. All subsequent audience questions and answers, and both speakers' later closing statements, are excluded; neither speaker receives credit or penalties for that material. These scores are not an assessment of the complete recording."},{"id":"atkins-law-science-philosophy-formal-rounds-2014","number":"257","notice":"Only the opening statements and first rebuttals (3:01–28:50) are assessed. The entire subsequent audience-question portion, including both speakers' later replies, concessions, and concluding comments, is excluded; neither speaker receives credit or penalties for that material. These scores are not an assessment of the complete recording."},{"id":"white-price-bible-truth-formal-rounds-2010","number":"258","notice":"Only the formal rounds (7:04–2:16:31), including openings, rebuttals, cross-examinations, and both closing statements, are assessed. Introductions, all later audience questions and answers, and the moderator's separate concluding argument are excluded; neither speaker receives credit or penalties for that material. These scores are not an assessment of the complete recording."},{"id":"sharpton-hitchens-god-religion-morality-2007","number":"261","notice":"This assessment uses the complete automatic English captions and audio verification of all 31 selected arguments across 23 passages. Under the primary-speaker exception, moderator Jacob Weisberg’s substantive civil-rights, deism, and scripture interventions, together with their directly dependent replies, are excluded from both speakers’ scores."},{"id":"dembski-hitchens-good-god-existence-2010","number":"263","notice":"This assessment uses the complete automatic captions and 13 bounded, independent caption-blind audio transcription checks. It involved no direct listening and no complete-audio verification. Quotations reproduce exact eligible transcript spans; argument descriptions and critiques are condensed from the source. Advocacy by Dan Panetti and Caleb, the unnamed moderator, and Larry Taylor was excluded, totaling about 4 minutes 58 seconds, or 3.45% of the assessed window. Neither side received credit or penalty for excluded participation or for replies dependent on it."},{"id":"chopra-dawkins-consciousness-purpose-spirituality-2013","number":"264","notice":"Direct quotations reproduce exact eligible substrings from the retained timestamped English captions; argument descriptions are condensed summaries of those captions. The retained scope was reviewed through the complete English caption record. Limited independent audio transcription covered 15 bounded verification clips and two source-context clips. No direct listening or complete-recording audio verification is claimed, and the clips establish wording and attribution rather than scientific or historical truth. This assessment covers the independent exchanges between Deepak Chopra and Richard Dawkins. By explicit editorial approval, Andrés Roemer’s substantive interventions and their directly dependent replies are excluded, including the moderator-led persuasion and free-will exchange. Neither debater receives credit or penalty for the excluded material; this is not an assessment of every contribution in the recording."},{"id":"dillahunty-giunta-faith-rational-justification-2018","number":"266","notice":"By explicit editorial approval, this assessment covers only the main conversation, approximately 05:29–1:16:07, not the full 2:28:59 recording or its audience question period. Both speakers agree that faith understood as confidence can be rational; the scored question concerns their narrower disagreement over whether God’s possibility must first be demonstrated. The moderator’s substantive interventions and their directly dependent replies, including the closing exchange from approximately 1:06:18, are excluded under the primary-speaker scope rule. Neither debater receives credit or penalty for excluded material. Complete English captions were reviewed for source screening; limited independent audio transcription checked the scope boundaries and speaker changes. No direct listening or complete-recording audio verification is claimed."},{"id":"hitchens-wilson-truth-goodness-beauty-2008","number":"267","notice":"This assessment covers only the opening presentations and direct exchange, approximately 11:46–1:13:22, with the final complete reply included. Audience Q&A, the later closing statements, and the introduction are not assessed. A verified replay at approximately 59:26–1:09:10 is counted only once; timestamps refer to the original upload. Scores describe this limited excerpt, not the complete event."},{"id":"sacks-dawkins-science-religion-2012","number":"268","notice":"This assessment covers selected, self-contained Jonathan Sacks–Richard Dawkins exchanges within the main conversation, approximately 2:09–41:54. Substantive moderator interventions and their dependent replies are excluded, removing approximately 20:31 (51.6%) of that window and leaving approximately 19:14 of eligible conversation. The exclusions include host-led exchanges about book tone, selective evidence, divine intervention, religious upbringing, antisemitism, and moral necessity. Introductions and all audience Q&A are also unscored. Neither speaker receives credit or penalty for excluded material; the scores do not assess the complete event."},{"id":"craig-pigliucci-christian-god-2001","number":"271","notice":"This assessment covers both opening statements, both rounds of rebuttal, and both closing statements (approximately 6:31–1:39:05). The moderator’s subsequent third-position interlude and the entire audience Q&A, including both speakers’ answers, are excluded. Neither side receives credit or penalty for excluded material; these scores assess the approved formal debate, not the complete event."},{"id":"craig-dacey-god-existence-2004","number":"273","notice":"This assessment covers both opening statements, both rounds of rebuttal, and both closing statements (approximately 5:00–1:40:07). The entire audience Q&A, including both speakers’ answers and dependent replies, is excluded. Neither side receives credit or penalty for excluded material; these scores assess the approved formal debate, not the complete event."},{"id":"shermer-scrivener-good-without-god-2024","number":"277","notice":"By explicit editorial approval, this assessment scores only Michael Shermer and Glen Scrivener across the complete substantive exchange. Moderator Vince Vitale supplies substantive philosophical questions and challenges beyond the ordinary incidental-host allowance; his contributions remain context, and the debaters’ own replies remain eligible for assessment. No argument or score is assigned to a debater merely because Vitale advances it. Unequal questioning is considered when selecting moves and evaluating opportunities to respond. This is a recording-specific exception, not an assessment of a strictly two-speaker recording."},{"id":"lennox-tooley-atheism-christianity-2013","number":"278","notice":"The available recording ends after Michael Tooley’s closing remarks. A contemporary account also describes a closing statement by John Lennox, which is absent from the versions located. This assessment covers the available recording; neither speaker is penalized for material or replies missing from it."},{"id":"slick-barker-god-existence-2014","number":"279","notice":"This assessment uses the recoverable portions of the recording. A 33-second passage at the start of Matt Slick’s rebuttal (41:07.52–41:40.64) could not be reliably transcribed and is excluded. Neither speaker receives credit or a penalty for that passage, and no claim that an argument went unanswered relies on the missing material."},{"id":"turek-normark-god-existence-2014","number":"280","notice":"By explicit editorial approval, this assessment scores only Frank Turek and Dennis Nørmark across the substantive debate. Moderator Adam Holm contributes independent arguments and challenges, which remain context; the debaters’ own replies remain eligible for assessment. No moderator argument is credited to either debater. Unequal questioning is considered when selecting moves and evaluating opportunities to respond. This is a recording-specific exception to the ordinary two-speaker source rule."},{"id":"butt-barker-biblical-god-2009","number":"285","notice":"This assessment covers the formal opening statements, rebuttals, and cross-examination (approximately 5:54–1:08:57), plus both closing statements (1:46:09–1:57:06). The entire audience Q&A, including both speakers’ answers and dependent replies, is excluded at the editor’s request. Neither speaker receives credit or penalty for excluded material. These scores assess the formal rounds and closings, not the complete event."},{"id":"nesan-dillahunty-jesus-prophecy-2021","number":"286","notice":"This assessment covers the formal opening statements, rebuttals, cross-examination, and the speakers’ subsequent discussion before audience Q&A (approximately 0:12–1:02:31). This recording has no separate formal closing statements. The entire audience Q&A, including both speakers’ answers and dependent replies, plus the host’s after-show, is excluded at the editor’s request. Neither speaker receives credit or penalty for excluded material. These scores assess the debate portion, not the complete recording."},{"id":"johnson-barker-god-existence-2022","number":"287","notice":"This assessment covers both formal opening statements and rebuttals (approximately 10:28–1:03:56), plus both closing statements (1:22:28–1:30:03). The entire audience Q&A, including both speakers’ answers and dependent replies, and the hosts’ introductory and concluding discussion are excluded at the editor’s request. Neither speaker receives credit or penalty for excluded material. These scores assess the formal rounds and closings, not the complete recording."},{"id":"shermer-vandeweghe-jesus-miracles-2019","number":"288","notice":"This assessment covers both formal opening statements and rebuttals (approximately 6:56–1:11:59), plus both closing statements (1:49:07–1:58:23). The entire moderated discussion and audience Q&A, including both speakers’ answers and dependent replies, and the introductory montage and surrounding host remarks are excluded at the editor’s request. Neither speaker receives credit or penalty for excluded material. These scores assess the formal rounds and closings, not the complete recording."}],"year":"2019","videoId":"AgVCo5Jeq3U","modelLabel":"5.6 Sol","tagCount":5,"people":[{"name":"Michael Shermer","slug":"michael-shermer"},{"name":"Luuk Vandeweghe","slug":"luuk-vandeweghe"}],"graph":{"sectionSideScores":3172,"minimum":48,"maximum":95,"buckets":[{"range":"48–49","count":1},{"range":"50–51","count":1},{"range":"52–53","count":1},{"range":"54–55","count":1},{"range":"56–57","count":3},{"range":"58–59","count":9},{"range":"60–61","count":10},{"range":"62–63","count":14},{"range":"64–65","count":36},{"range":"66–67","count":53},{"range":"68–69","count":77},{"range":"70–71","count":133},{"range":"72–73","count":187},{"range":"74–75","count":198},{"range":"76–77","count":285},{"range":"78–79","count":345},{"range":"80–81","count":382},{"range":"82–83","count":395},{"range":"84–85","count":333},{"range":"86–87","count":285},{"range":"88–89","count":233},{"range":"90–91","count":137},{"range":"92–93","count":41},{"range":"94–95","count":12}],"debateNumber":"288","contribution":[87,71,82,78,80,78,76,76,80,73],"publishedDebates":288,"eachDebateMatched":true,"noScoreCalculation":true}};
const staticReplay=async function replayStaticScope(page,cfg) {
  const observations=[],screenshots=[];
  for(const viewport of [{width:1440,height:1000},{width:390,height:844}]) {
    const context=await page.context().browser().newContext({javaScriptEnabled:false,viewport});
    try {
      const p=await context.newPage();
      for(const item of cfg.scopeCases) {
        const response=await p.goto(cfg.origin+'/debate/'+item.id+'/');
        if(response.status()!==200)throw Error('Static HTTP failure '+item.id);
        const notice=p.locator('.seo-fallback > .source-context');await notice.waitFor({state:'visible'});
        if((await notice.locator('span').innerText()).trim()!==item.notice)throw Error('Static notice mismatch '+item.id);
        const nb=await notice.boundingBox(),sb=await p.locator('.seo-fallback > p:not(.eyebrow)').first().boundingBox();
        if(!nb||!sb||nb.y+nb.height>sb.y+1)throw Error('Static scope must precede scores '+item.id);
        const width=await p.evaluate(()=>({viewport:innerWidth,document:document.documentElement.scrollWidth}));
        if(width.document>width.viewport+1)throw Error('Static overflow '+item.id);
        observations.push({debateNumber:item.number,viewport,noticeBeforeScores:true,noticeExact:true});
        if(item.id===cfg.candidate.id && cfg.screenshots!==false) {
          const file=cfg.screenshotDirectory+'/'+cfg.prefix+'-static-'+viewport.width+'.png';await p.screenshot({path:file});screenshots.push(file);
        }
      }
    } finally {await context.close();}
  }
  return {status:'passed-static-source-scope',observations,screenshots};
};
const interactiveReplay=async function replayPublication(page, cfg) {
