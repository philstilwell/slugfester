      "events": "85-97",
      "anchor": "Aron links violent religious commands and faithful obedience to the contention that faith is dangerous."
    },
    {
      "events": "185-201",
      "anchor": "Jones challenges whether secular law supplies a non-arbitrary objective foundation for moral rights."
    },
    {
      "events": "476-581",
      "anchor": "The exchange distinguishes medical misinformation, evidential standards, prayer, and whether faith substitutes for treatment or functions as trust under uncertainty."
    },
    {
      "events": "618-689",
      "anchor": "Aron invokes cross-country outcomes and climate rejection; Jones presses the limits of causal inference from those comparisons."
    },
    {
      "events": "727-918",
      "anchor": "The parties contest necessary causation, intelligence, and the evidential force of meta-analyses rather than merely whether correlations exist."
    },
    {
      "events": "1015-1193",
      "anchor": "The cross-examination covers intelligence, evolution, and how much explanatory or predictive weight the cited associations can carry."
    },
    {
      "events": "1214-1399",
      "anchor": "Jones develops pistis as commitment or assurance rather than blind belief, distinguishes covenantal interpretation, and challenges omitted variables in the empirical comparisons."
    },
    {
      "events": "1457-1482",
      "anchor": "Climate acceptance is used as a test case for whether religiosity itself, political grouping, or other factors best explain the observed pattern."
    }
