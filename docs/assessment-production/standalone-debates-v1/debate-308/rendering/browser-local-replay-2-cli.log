await (async (page) => {
const cfg={"candidate":{"number":"308","id":"schieber-rauser-religious-disagreement-2017","date":"2026-10-09","title":"Justin Schieber vs Randal Rauser — Religious Disagreement and God (2017)","label":"Religious Disagreement and God","topicCategory":"god-theism-atheism","youtubeUrl":"https://www.youtube.com/watch?v=G_jSS5Z4oFU","duration":"45 min","motion":"Is religious disagreement evidence against God’s existence?","assessmentModel":"5.6 Sol","assessmentRubric":"Slugfester Reassessment Rubric v2","sourceNote":"By explicit editorial approval, this assessment scores only Justin Schieber and Randal Rauser’s discussion and concluding replies, approximately 12:41–1:00:59, excluding programme breaks. Host Justin Brierley contributes arguments and questions as unscored context; each guest’s own replies remain eligible, but no host argument is credited to either guest. Unequal prompting is considered when evaluating opportunities to respond. This is a moderated discussion without timed formal rounds or paired formal closing speeches. Introductions, book promotion and the outro are excluded and supply no credit, penalty or inference of a failure to reply. The source is the complete public automatic-caption track; no direct human listening or auxiliary audio transcription is claimed. Featured quotations reproduce the locked captions exactly; argument descriptions are condensed summaries. The programme listing establishes the participants and January 14, 2017 event date only, and contributes no scoring evidence.","scoringNote":"Scores are AI-generated estimates of argumentative performance, rather than judgments about worldview truth; the separate AI Contribution does not affect these scores.","sides":{"pro":{"name":"Disagreement is evidence against God","speaker":"Justin Schieber","color":"teal"},"con":{"name":"Disagreement does not count against God","speaker":"Randal Rauser","color":"coral"}},"score":{"pro":85,"con":78,"winner":"pro"},"summary":"Schieber’s calibrated comparative case outscored Rauser’s thoughtful but insufficiently evidenced appeals to permissive divine reasons and underdetermination.","quotes":{"pro":{"text":"the disagreement that we have in our actual world is evidence against God","context":"Schieber states the comparative conclusion of his independent-doctrinal-convergence thought experiment, treating actual disagreement as defeasible evidence rather than deductive disproof."},"con":{"text":"some religious disagreement is simply the result of people being mistaken","context":"Rauser distinguishes human error from contradictory divine communication while defending accommodation and a shared moral framework."}},"sections":[{"sectionId":"disagreement-as-evidence","title":"From fundamental disagreement to evidence","timebox":"12:39–22:38","score":{"pro":84,"con":76},"exchanges":[{"pro":{"ledgerMoveId":"landlord-disagreement-tension","time":"12:39","score":81,"role":"Constructive","words":"Fundamental incompatible beliefs among devout believers resemble tenants receiving conflicting private messages, creating relational tension that a truth-valuing God would seemingly address.","critique":"Strongest feature: The landlord analogy concretely narrows the target to fundamental conflicts among willing believers and links confusion with impaired divine and interpersonal relationships. Principal limitation: It leaves partly implicit why divine communication inherits a landlord’s clarification duty, while illustrative incompatibilities establish neither prevalence nor representative distribution. Live burden: Schieber must show consequential disagreement is appreciably less expected under relational theism than atheism after admitting plausible goods from limited uncertainty. Locked score: 81/100 reflects a lucid, relevant, and carefully bounded opening whose landlord analogy clarifies the relational concern, while the missing comparative baseline and unmeasured distribution of conflict keep its evidential warrant suggestive rather than independently demonstrated.","tags":[]},"con":{"ledgerMoveId":"analogy-assumption-and-degree-burden","time":"16:58","score":76,"role":"Reply","words":"Rauser separates unequal divine disclosure from contradictory revelation and demands evidence that the observed amount and distribution of disagreement exceed what God could permissibly allow.","critique":"Strongest feature: Rauser isolates authorship and degree as different questions, thereby pressing the analogy’s transfer and the evidential baseline at genuinely vulnerable points. Principal limitation: His first objection targets a clarification Schieber expressly supplies, while requiring proof that God has no sufficient reason converts a modest likelihood claim into an impossibility burden. Live burden: Rauser must explain why sincere, consequential, persistent error is reasonably expected under divine relationship rather than merely compatible with an unidentified purpose. Locked score: 76/100 rewards a degree challenge that materially sharpens the debate and correctly requests an evidential baseline, while reducing credit because the causal reconstruction misses Schieber’s clarification and the proposed burden sometimes exceeds what a defeasible comparison requires.","tags":[{"type":"fallacy","label":"Argument from ignorance","url":"https://logfall.com/fallacies/argument-from-ignorance/","context":"Requires Schieber to show God could have no sufficient reason before treating disagreement as comparative evidence."},{"type":"fallacy","label":"Red herring","url":"https://logfall.com/fallacies/red-herring/","context":"Recasts claimed incompatible revelations as God directly revealing contradictions instead of addressing absent correction of sincere error."}]}},{"pro":{"ledgerMoveId":"fundamental-errors-require-correction","time":"19:38","score":87,"role":"Reply","words":"Schieber denies that God issues contradictions, contrasts trivial disputes with salvation, history, divine nature, and political morality, and argues that serious misunderstandings invite correction.","critique":"Strongest feature: Schieber repairs the central misreading by separating human revelation claims from divine authorship and ties correction to specific high-stakes disputes rather than every doctrinal variation. Principal limitation: The examples establish seriousness more readily than frequency, causal harm, or the probability that a relational God would intervene consistently across cultures, and the record does not quantify how often those errors produce the alleged harms. Live burden: He must explain why development, freedom, accommodation, or other relational goods do not justify these errors at roughly their observed scale. Locked score: 87/100 recognizes an exceptionally precise, responsive, and charitable correction that preserves the strong high-stakes inference, while leaving open the proportional amount of clarification expected from God and the possible role of countervailing relational goods.","tags":[]}}]},{"sectionId":"reasons-to-permit-disagreement","title":"Possible reasons to permit disagreement","timebox":"23:06–32:52","score":{"pro":86,"con":76},"exchanges":[{"pro":{"ledgerMoveId":"team-needs-top-down-clarity","time":"28:38","score":86,"role":"Reply","words":"Schieber reverses the team-building analogy: cooperation fails when participants receive incompatible goals, rules, and deadlines, so fundamental religious confusion calls for top-down clarification.","critique":"Strongest feature: The reconstructed exercise shows disagreement about the shared task disabling cooperation instead of cultivating it, and its rules-goals-deadlines contrast makes that reversal unusually transparent. Principal limitation: It assumes religions lack enough common purpose for collaboration and does not establish that divine guidance must resemble an instructor’s explicit briefing, especially where traditions share broad moral aims despite doctrinal differences. Live burden: Schieber must connect the model to actual fundamental disputes while allowing that partial shared moral aims and guidance may survive. Locked score: 86/100 credits a transparent and forceful reversal of Rauser’s team-building example with excellent direct engagement, while withholding further credit because the analogy’s fit with actual religious communities and their surviving common purposes remains insufficiently established.","tags":[]},"con":{"ledgerMoveId":"virtue-and-staged-pedagogy","time":"23:06","score":77,"role":"Reply","words":"Rauser proposes that interpretive tension can build character and that a master teacher may provide developmentally fitted instruction, making some disagreement compatible with divine pedagogy.","critique":"Strongest feature: Rauser supplies two intelligible mechanisms—cooperative formation and staged teaching—rather than resting on a bare assertion that God might possess unknown reasons. Principal limitation: The grammar lesson concerns progressively expanded instruction, whereas disputed doctrines can contradict one another about shared goals, and no evidence connects their distribution to developmental readiness. Live burden: He must show these pedagogical benefits arise from consequential disagreements and plausibly outweigh persistent false belief’s relational costs. Locked score: 77/100 reflects clear and relevant mechanisms offered with appropriately limited confidence, while the loose mapping from progressive classroom instruction to mutually incompatible fundamental doctrines prevents these analogies from adequately explaining the most consequential conflicts in the discussion.","tags":[]}},{"con":{"ledgerMoveId":"freedom-moral-knowledge-and-fair-judgment","time":"26:58","score":74,"role":"Reply","words":"Rauser combines freedom to seek God, general moral knowledge, and judgment proportionate to available revelation to mitigate unfairness despite unequal doctrinal access.","critique":"Strongest feature: The numbered considerations coherently describe fair judgment amid unequal information and prevent disagreement from implying a complete absence of actionable moral guidance. Principal limitation: The move never shows that clarity threatens freedom, that shared moral knowledge is adequate, or that fair judgment answers truth and richer-relationship concerns, leaving the three mitigations only partially integrated with one another. Live burden: Rauser must explain why persistent sincere error remains unsurprising under a truth-valuing relational God, beyond showing that punishment could remain proportionate. Locked score: 74/100 credits useful subsidiary defenses and an intelligible fairness principle, while limited supporting evidence, weak integration among the three considerations, and incomplete contact with God’s proposed communicative responsibility substantially restrict the move’s force.","tags":[]}},{"con":{"ledgerMoveId":"mistake-accommodation-and-shared-moral-framework","time":"31:05","score":77,"role":"Reply","words":"Rauser attributes some disagreement to human mistake or rebellion, compares tailored disclosure to managerial accommodation, and invokes common moral guidance across cultures.","critique":"Strongest feature: The response distinguishes human error, differentiated instruction, and residual common guidance, offering several intelligible routes by which disagreement could coexist with theism. Principal limitation: Repeating that God need not issue contradictions misses Schieber’s stated concern about absent correction, while accommodation and universal morality lack supporting evidence, particularly concerning communities that sincerely seek rather than rebel. Live burden: Rauser must show how these mechanisms predict the persistence and specificity of sincere disagreements instead of merely describing possibilities compatible with them. Locked score: 77/100 recognizes a clear three-part structure and several relevant alternatives, while incomplete responsiveness to the absent-correction issue, minimal substantiation for cross-cultural moral adequacy, and an uncharitable causal reconstruction prevent a stronger result.","tags":[{"type":"fallacy","label":"Red herring","url":"https://logfall.com/fallacies/red-herring/","context":"Repeats that God need not reveal incompatible information instead of answering why consequential sincere misunderstandings persist uncorrected."}]}}]},{"sectionId":"truth-salvation-and-relationship","title":"Truth, salvation and kinds of relationship","timebox":"33:33–44:20","score":{"pro":85,"con":79},"exchanges":[{"pro":{"ledgerMoveId":"claimed-revelation-still-needs-clarification","time":"33:33","score":86,"role":"Reply","words":"Schieber reiterates that believers sincerely interpret incompatible claims as revelation and argues that an instructor should correct fundamental goal-confusion even without causing it.","critique":"Strongest feature: The reply cleanly separates responsibility for producing error from reasons to correct it, preserving the evidential question after conceding that God need not communicate contradictions. Principal limitation: Its instructor model assumes divine purposes prioritize explicit common goals and gives no independent measure of clarification expected amid freedom or cultural mediation. Live burden: Schieber must translate the corrective intuition into a comparative prediction about actual kinds, stakes, and persistence of religious misunderstanding. Locked score: 86/100 rewards an exceptionally precise, responsive, and charitable distinction between causing error and correcting it, while the absence of an independently defended prediction about how purposeful divine communication should correct sincere communities over time limits the ultimate comparison.","tags":[]},"con":{"ledgerMoveId":"exclusivism-not-required","time":"35:03","score":77,"role":"Reply","words":"Rauser argues that bare theism need not entail exclusivist salvation: an inclusivist God may judge people by their evidence and hearts despite missing detailed doctrines.","critique":"Strongest feature: Rauser sharply distinguishes bare theism from exclusivism and presents a coherent available-evidence model that blocks necessary eternal loss from doctrinal error. Principal limitation: Schieber’s case does not depend on exclusivism, and the reply leaves untouched truth, conflict, correction, and the comparative richness of informed relationship, including conflict among believers and diminished awareness of the divine person. Live burden: Rauser must show that inclusivist fairness explains divine permission of consequential false belief, rather than only preventing unjust punishment for it. Locked score: 77/100 credits a logically coherent and clearly expressed correction about the scope of bare theism, while the reply’s narrow focus on salvation, overstatement of Schieber’s dependence, and failure to address non-salvific relationship costs reduce responsiveness and charity.","tags":[{"type":"fallacy","label":"Red herring","url":"https://logfall.com/fallacies/red-herring/","context":"Answers an exclusivist salvation argument although Schieber’s stated case also rests on truth and relational harms."}]}},{"pro":{"ledgerMoveId":"truth-and-interpersonal-harm-without-exclusivism","time":"36:08","score":85,"role":"Reply","words":"Schieber rejects exclusivism, arguing that incompatible beliefs still obstruct informed divine relationship, intensify conflict, restrict interfaith contact, and matter because truth itself has value.","critique":"Strongest feature: Schieber directly identifies non-salvific costs—falsehood, impaired awareness, conflict, and parental restriction—so inclusivist judgment cannot dissolve the broader concern. Principal limitation: The vivid examples do not establish representativeness, doctrinal causation, or their balance against dialogue and pluralism; rapid transitions also compress important distinctions, so their aggregate importance within the actual disagreement pattern remains uncertain. Live burden: He must show the observed net pattern of harms and lost relationships is more surprising given God than given atheism. Locked score: 85/100 reflects strong coherence and a direct restoration of Schieber’s wider truth-and-relationship burden, while the illustrative examples lack representative causal evidence separating doctrinal effects from political power, group identity, and other social conditions.","tags":[]},"con":{"ledgerMoveId":"acquaintance-before-propositions","time":"38:14","score":80,"role":"Reply","words":"Rauser distinguishes propositional knowledge from acquaintance, using infant–parent development to argue that profound relationship may exist before accurate, detailed doctrine.","critique":"Strongest feature: The distinction identifies relational value beyond doctrinal accuracy, and the infant–parent example vividly shows valuable attachment preceding articulated propositions. Principal limitation: The analogy never establishes that adults with incompatible concepts possess comparable divine acquaintance and answers absence of relationship better than the claim that informed awareness is richer, particularly because the divine acquaintance posited here is not independently identified. Live burden: Rauser must explain how acquaintance is identified, distributed, and sufficient to offset false understanding and interpersonal harms. Locked score: 80/100 recognizes a clear, relevant, and vivid conceptual distinction, while the analogy remains speculative when extended from infant attachment to adult divine relationship and supplies no reliable marker distinguishing genuine acquaintance from sincere projection.","tags":[]}},{"pro":{"ledgerMoveId":"mutual-awareness-is-richer","time":"39:38","score":83,"role":"Reply","words":"Schieber grants substantive nonaware relationship but argues that freely chosen mutual awareness is richer, leaving unexplained why God would permit false concepts to obstruct it.","critique":"Strongest feature: Schieber preserves Rauser’s insight by conceding acquaintance value, then argues comparatively that willing, informed, two-way awareness realizes a richer relational opportunity. Principal limitation: The ranking is not independently defended across infant, adult, and divine cases, while saying God settles assumes no offsetting developmental or communal goods, and Schieber supplies no criterion for weighing those goods across developmental contexts. Live burden: He must show improved awareness increases relationship without comparable losses and that current false understandings actually block that improvement. Locked score: 83/100 credits a responsive concession and a clearly identified residual relational opportunity, while the proposed hierarchy among acquaintance, awareness, freedom, dependence, and developmental timing remains intuitive and does not yet incorporate possible countervailing goods.","tags":[]},"con":{"ledgerMoveId":"infant-coworker-and-dialogue-goods","time":"42:40","score":80,"role":"Reply","words":"Rauser contrasts profound infant–mother acquaintance with proposition-rich coworker familiarity and cites his friendly exchange with Schieber as a relational good realized through disagreement.","critique":"Strongest feature: The infant–coworker contrast shows information is neither necessary nor sufficient for intimacy, while their dialogue gives a concrete good actually produced through disagreement. Principal limitation: Neither example shows awareness lacks comparative value or that one conversation explains widespread fundamental division; moving from local benefit to divine permission remains incomplete, especially because one friendly dialogue may be atypical of consequential religious conflict. Live burden: Rauser must establish that acquaintance and dialogue goods systematically offset the truth-related and interpersonal costs Schieber identifies. Locked score: 80/100 reflects a vivid, responsive comparison grounded partly in an observed constructive exchange, while its limited generalizability and failure to show that wider relational goods require the actual depth and persistence of religious division constrain explanatory reach.","tags":[]}}]},{"sectionId":"independent-doctrinal-convergence","title":"Independent doctrinal convergence","timebox":"41:53–55:36","score":{"pro":84,"con":79},"exchanges":[{"pro":{"ledgerMoveId":"detailed-convergence-counterfactual","time":"41:53","score":82,"role":"Constructive","words":"Schieber imagines isolated populations independently reaching the same detailed doctrines, argues that such convergence would favor theism, and infers that actual disagreement favors atheism.","critique":"Strongest feature: The independent-continent thought experiment offers a crisp comparative test and explicitly frames the reasoning as abductive evidence rather than contradiction or disproof. Principal limitation: Showing one counterfactual would favor God does not determine actual disagreement’s evidential sign; likelihoods, base rates, independence, and alternative explanations remain unspecified, and the thought experiment does not determine whether the actual observation is neutral or negative. Live burden: Schieber must show the observed world is less probable under theism than atheism, not merely less favorable than imagined convergence. Locked score: 82/100 rewards a clear abductive construction that directly advances the motion, while the absence of likelihoods conditioned on culture, cognition, divine aims, and competing mechanisms leaves the crucial step from imagined convergence to actual atheistic evidence incomplete.","tags":[]},"con":{"ledgerMoveId":"natural-convergence-underdetermines","time":"50:12","score":76,"role":"Reply","words":"Rauser compares recurring biological forms across isolated lineages with possible theological convergence, arguing that agreement patterns alone cannot reliably distinguish theism from atheism.","critique":"Strongest feature: Rauser introduces an alternative mechanism and cautiously concludes underdetermination, challenging the assumption that independent agreement uniquely indicates intelligent revelation. Principal limitation: Similar biological structures do not demonstrate selection toward content-rich doctrine, and the analogy shifts from detailed convergence to broad agreement without a supported bridge, especially for doctrines with no articulated connection to reproductive or social advantage. Live burden: Rauser must identify credible pressures predicting specific doctrines or show the atheistic likelihood is high enough to neutralize Schieber’s comparison. Locked score: 76/100 credits a relevant, calibrated modal challenge and a recognizable alternative mechanism, while the unsupported transfer from biological convergence to stable agreement on content-rich theology leaves the central evidential warrant speculative.","tags":[{"type":"fallacy","label":"Equivocation","url":"https://logfall.com/fallacies/equivocation/","context":"Shifts from specific shared doctrines to broad theological belief when proposing natural convergent pressures."}]}},{"pro":{"ledgerMoveId":"specific-doctrines-resist-natural-convergence","time":"52:28","score":85,"role":"Reply","words":"Schieber concedes natural explanations for generic spirit belief but argues they do not plausibly predict independent convergence on Trinity, divine simplicity, or particular atonement theories.","critique":"Strongest feature: The generic-specific distinction pinpoints Rauser’s mismatch and names content-rich doctrines requiring a stronger mechanism than recurring broad supernatural concepts. Principal limitation: Schieber invokes evolutionary literature and asserts implausibility without evidence or probabilities, then moves rapidly from hypothetical agreement to actual disagreement’s direction, while the transcript supplies no independent support for the evolutionary literature invoked. Live burden: He must substantiate why atheism predicts diversity better than relational theism with permissive reasons predicts it. Locked score: 85/100 rewards a precise and highly responsive specificity objection central to Schieber’s test, while named theological examples cannot substitute for supported comparative probabilities across natural selection, cultural transmission, and purposive divine communication.","tags":[{"type":"fallacy","label":"Appeal to authority","url":"https://logfall.com/fallacies/appeal-to-authority/","context":"Invokes knowledgeable readers and unnamed literature as support that selective explanations stop at generic supernatural belief."}]},"con":{"ledgerMoveId":"agreement-does-not-entail-current-atheistic-support","time":"54:03","score":81,"role":"Reply","words":"Rauser argues that even if greater doctrinal agreement favored God, it would not follow that the actual relative lack of agreement favors atheism.","critique":"Strongest feature: The closing distinction exposes a missing likelihood comparison: evidence favoring one hypothesis under one observation does not automatically reverse under another observation. Principal limitation: His appeals to projection theories and broad agreement miss content-rich doctrines, while logical caution alone does not establish that current disagreement is neutral. Live burden: Rauser may rest on exposing Schieber’s missing inference; only a stronger claim that current disagreement is evidentially neutral would require him to supply a full rival probability account. Locked score: 81/100 recognizes a logically sharp, relevant, and properly conditional objection that blocks Schieber’s shortcut, while the accompanying broad naturalistic discussion lacks doctrinal specificity and the move remains diagnostic rather than an independent demonstration of neutrality.","tags":[]}}]},{"sectionId":"closing-scope-and-cumulative-force","title":"Closing scope and cumulative force","timebox":"56:31–1:01:02","score":{"pro":88,"con":79},"exchanges":[{"pro":{"ledgerMoveId":"defeasible-cumulative-weight","time":"56:31","score":88,"role":"Constructive","words":"Schieber characterizes disagreement as one significant but defeasible consideration within a cumulative worldview comparison, explicitly allowing stronger theistic evidence and denying deductive disproof.","critique":"Strongest feature: Schieber states the burden with exceptional discipline: the argument contributes weight, may be outweighed, and neither disproves God nor makes theism automatically irrational. Principal limitation: This scope clarification adds little evidence for the claimed significance and relies on earlier moves to establish the disagreement consideration’s magnitude, leaving the word significant dependent on unresolved earlier probability comparisons. Live burden: The pro side must justify that magnitude after underdetermination, permissive reasons, and competing evidence are jointly considered. Locked score: 88/100 reflects exceptional precision, calibration, and charity in separating one argument’s significant local force from a complete worldview verdict, while acknowledging that the preceding exchange rather than this scope statement must establish the claimed evidential magnitude.","tags":[]},"con":{"ledgerMoveId":"internal-disagreement-and-relational-goods","time":"58:49","score":79,"role":"Reply","words":"Rauser concedes serious Christian divisions, suggests providential ambiguity can promote charitable inquiry, and cites ecumenical listening as relational value realized through continued disagreement.","critique":"Strongest feature: Rauser treats the objection seriously, names concrete disputes, and grounds a proposed benefit in ecumenical experience, producing a charitable and limited final response. Principal limitation: Dialogue goods and possible providential reasons do not justify the observed amount or consequences of ambiguity, nor answer every truth-based corrective challenge, particularly where ambiguity concerns initiation, sacrament, or salvation rather than harmless diversity. Live burden: Rauser must show these benefits make fundamental division expected under God rather than merely compatible with permission. Locked score: 79/100 credits a serious concession, concrete relational experience, and notably charitable final posture, while the move offers no distributional account showing why dialogue goods justify the hardest persistent conflicts and does not resolve the earlier truth-based correction burden.","tags":[{"type":"bias","label":"Subjective validation","url":"https://cogbias.site/biases/subjective-validation/","context":"Treats his personally enriching ecumenical dialogue as evidence of disagreement’s divinely realized relational value."},{"type":"fallacy","label":"Argument from ignorance","url":"https://logfall.com/fallacies/argument-from-ignorance/","context":"Treats failure to rule out morally sufficient divine reasons as grounds to reject the comparative inference."}]}}]}],"overall":{"pro":{"score":85,"strengths":["Schieber consistently framed disagreement as defeasible comparative evidence, preserving a modest burden and expressly allowing other theistic arguments to outweigh it.","His distinction between God causing contradictions and God failing to correct sincere consequential errors neutralized Rauser’s persistent causal reconstruction.","The shift from generic supernatural belief to independently convergent content-rich doctrines gave the convergence argument a precise observable comparison."],"blunders":[{"text":"The independent-convergence counterfactual did not itself establish the likelihood ratio needed to show that actual disagreement positively favors atheism.","links":[]},{"text":"Several serious-harm examples remained illustrative; their prevalence, causal representativeness, and net balance against developmental goods were not established.","links":[]}]},"con":{"score":78,"strengths":["Rauser supplied coherent permissive reasons—formation, staged teaching, freedom, accommodation, and fair judgment—instead of relying entirely on bare possibility.","His propositional-knowledge and acquaintance distinction identified a relationship dimension that Schieber’s doctrinal emphasis could not simply ignore.","The closing separation of hypothetical support from actual-world evidential direction exposed a genuine missing step in Schieber’s counterfactual argument."],"blunders":[{"text":"Rauser repeatedly treated the analogy as divine delivery of incompatible messages after Schieber located the problem in uncorrected human misunderstanding.","links":[]},{"text":"His natural-convergence proposal moved from recurring biological forms and broad belief to detailed doctrine without evidence for that transfer.","links":[]}]}},"logicalExtension":{"pro":{"finalArgument":{"thesis":"Fundamental religious disagreement counts against a relational God when its pattern is less expected under purposeful truth-directed communication than under unguided cultural development.","premises":["A perfectly informed relational God would ordinarily have reason to enable willing people to identify that God and avoid consequential false beliefs about relationship, conduct, and salvation.","The actual pattern includes sincere, persistent, mutually incompatible convictions on precisely those central subjects, despite participants often seeking truth and claiming divine guidance.","Limited ambiguity can promote freedom, inquiry, or character, but those goods do not automatically require confusion about the shared goal or indefinite persistence of harmful fundamental error.","Unguided cultural transmission, institutional inheritance, and ordinary human interpretation readily permit geographically and historically divergent doctrines without positing a coordinating communicator.","The comparison should remain defeasible and discount disagreements whose developmental benefits or low stakes make them similarly expected under both worldviews."],"conclusion":"After those discounts, remaining sincere and consequential doctrinal fragmentation provides a meaningful but nonconclusive likelihood shift away from a truth-valuing relational God."},"newArguments":[{"title":"Correction Gradient","text":"A relational-communication hypothesis should predict a correction gradient: as an error becomes more consequential, more sincerely held, and more damaging to willing relationship, accessible corrective resources should become correspondingly stronger. Limited ambiguity may serve pedagogy or freedom, yet proportionality predicts stronger corrective access as relational and moral stakes rise. If trivial disputes remain unresolved while errors about salvation, divine character, or violence receive no reliably clearer correction, the missing gradient becomes specifically evidential. This tests proportionality rather than demanding uniform or instantaneous disclosure."},{"title":"Seeker Convergence Test","text":"Relational theism may predict that communities displaying greater sincerity, openness to correction, and freedom from coercive incentives should converge more reliably on central truths than otherwise comparable communities. Unguided cultural inheritance need not predict that association, because intellectual virtue can improve local reasoning while inherited starting points still anchor divergent doctrines. Evidence that unusually open and truth-seeking groups remain no more convergent than ordinary groups would sharpen the atheistic case; a strong positive association would instead support the hypothesis of responsive guidance."}]},"con":{"finalArgument":{"thesis":"Religious disagreement does not substantially count against God unless its distribution exceeds what divine accommodation, plural goods, and limited communicative aims would predict.","premises":["Relationship can include acquaintance, moral responsiveness, and developmental trust before participants possess uniform or accurate propositions about the person with whom they relate.","A just God can evaluate people according to available evidence and sincere response, preventing unequal doctrinal access from automatically producing unfair salvific consequences.","Some ambiguity can generate intellectual humility, charitable dialogue, cooperative inquiry, and freely developed understanding that immediate exhaustive disclosure would not realize identically.","Human error, rebellion, cultural inheritance, and differentiated capacities can produce doctrinal conflict without God issuing contradictions or abandoning every shared moral framework.","A counterfactual in which agreement favors theism cannot determine actual disagreement’s evidential sign without explicit likelihoods for both observations under both worldviews."],"conclusion":"Disagreement therefore remains compatible with and potentially expected under a relational God until calibrated comparison shows its observed severity overwhelms these mechanisms and goods."},"newArguments":[{"title":"Plural Access Model","text":"A divine communicator may aim first at morally usable access rather than identical conceptual representation. Different communities could receive partial practices, symbols, and moral insights that enable response while leaving theoretical synthesis to extended cross-cultural inquiry. Unlike bare accommodation, this predicts overlap in action-guiding norms alongside divergence in explanatory doctrine, plus improvement when communities exchange perspectives. The model would lose credibility if central guidance were wholly absent or dialogue systematically deepened confusion, giving it observable risk rather than unlimited flexibility."},{"title":"Epistemic Noncoercion","text":"Clearer evidence need not eliminate freedom, but perfectly unmistakable, continuously corrective communication could alter inquiry by making dissent appear cognitively or institutionally impossible. A God concerned with freely owned understanding might therefore permit evidence strong enough for responsible seeking yet weak enough to preserve interpretive agency and reciprocal teaching. This social-epistemic account predicts bounded ambiguity rather than total obscurity. Its credibility depends on explaining why present ambiguity is proportionate and why severe harmful errors are not corrected through less dominating forms of guidance."}]}}},"origin":"http://127.0.0.1:4177","prefix":"debate308-local","screenshots":true,"screenshotDirectory":"output/playwright","requiredReaderDisclosure":"By explicit editorial approval, this assessment scores only Justin Schieber and Randal Rauser’s discussion and concluding replies, approximately 12:41–1:00:59, excluding programme breaks. Host Justin Brierley contributes arguments and questions as unscored context; each guest’s own replies remain eligible, but no host argument is credited to either guest. Unequal prompting is considered when evaluating opportunities to respond. This is a moderated discussion without timed formal rounds or paired formal closing speeches. Introductions, book promotion and the outro are excluded and supply no credit, penalty or inference of a failure to reply. The source is the complete public automatic-caption track; no direct human listening or auxiliary audio transcription is claimed.","scopeCases":[{"id":"licona-carrier-resurrection-formal-rounds-2004","number":"255","notice":"Only the formal debate rounds (5:10–1:38:23) are assessed. The subsequent question-and-answer session, including moderator-authored challenges and both speakers' replies, is excluded; neither speaker receives credit or penalties for that material. These scores are not an assessment of the complete recording."},{"id":"aron-ra-jones-christianity-dangerous-formal-rounds-2019","number":"256","notice":"Only the opening statements and cross-examination (1:59–1:27:22) are assessed. All subsequent audience questions and answers, and both speakers' later closing statements, are excluded; neither speaker receives credit or penalties for that material. These scores are not an assessment of the complete recording."},{"id":"atkins-law-science-philosophy-formal-rounds-2014","number":"257","notice":"Only the opening statements and first rebuttals (3:01–28:50) are assessed. The entire subsequent audience-question portion, including both speakers' later replies, concessions, and concluding comments, is excluded; neither speaker receives credit or penalties for that material. These scores are not an assessment of the complete recording."},{"id":"white-price-bible-truth-formal-rounds-2010","number":"258","notice":"Only the formal rounds (7:04–2:16:31), including openings, rebuttals, cross-examinations, and both closing statements, are assessed. Introductions, all later audience questions and answers, and the moderator's separate concluding argument are excluded; neither speaker receives credit or penalties for that material. These scores are not an assessment of the complete recording."},{"id":"sharpton-hitchens-god-religion-morality-2007","number":"261","notice":"This assessment uses the complete automatic English captions and audio verification of all 31 selected arguments across 23 passages. Under the primary-speaker exception, moderator Jacob Weisberg’s substantive civil-rights, deism, and scripture interventions, together with their directly dependent replies, are excluded from both speakers’ scores."},{"id":"dembski-hitchens-good-god-existence-2010","number":"263","notice":"This assessment uses the complete automatic captions and 13 bounded, independent caption-blind audio transcription checks. It involved no direct listening and no complete-audio verification. Quotations reproduce exact eligible transcript spans; argument descriptions and critiques are condensed from the source. Advocacy by Dan Panetti and Caleb, the unnamed moderator, and Larry Taylor was excluded, totaling about 4 minutes 58 seconds, or 3.45% of the assessed window. Neither side received credit or penalty for excluded participation or for replies dependent on it."},{"id":"chopra-dawkins-consciousness-purpose-spirituality-2013","number":"264","notice":"Direct quotations reproduce exact eligible substrings from the retained timestamped English captions; argument descriptions are condensed summaries of those captions. The retained scope was reviewed through the complete English caption record. Limited independent audio transcription covered 15 bounded verification clips and two source-context clips. No direct listening or complete-recording audio verification is claimed, and the clips establish wording and attribution rather than scientific or historical truth. This assessment covers the independent exchanges between Deepak Chopra and Richard Dawkins. By explicit editorial approval, Andrés Roemer’s substantive interventions and their directly dependent replies are excluded, including the moderator-led persuasion and free-will exchange. Neither debater receives credit or penalty for the excluded material; this is not an assessment of every contribution in the recording."},{"id":"dillahunty-giunta-faith-rational-justification-2018","number":"266","notice":"By explicit editorial approval, this assessment covers only the main conversation, approximately 05:29–1:16:07, not the full 2:28:59 recording or its audience question period. Both speakers agree that faith understood as confidence can be rational; the scored question concerns their narrower disagreement over whether God’s possibility must first be demonstrated. The moderator’s substantive interventions and their directly dependent replies, including the closing exchange from approximately 1:06:18, are excluded under the primary-speaker scope rule. Neither debater receives credit or penalty for excluded material. Complete English captions were reviewed for source screening; limited independent audio transcription checked the scope boundaries and speaker changes. No direct listening or complete-recording audio verification is claimed."},{"id":"hitchens-wilson-truth-goodness-beauty-2008","number":"267","notice":"This assessment covers only the opening presentations and direct exchange, approximately 11:46–1:13:22, with the final complete reply included. Audience Q&A, the later closing statements, and the introduction are not assessed. A verified replay at approximately 59:26–1:09:10 is counted only once; timestamps refer to the original upload. Scores describe this limited excerpt, not the complete event."},{"id":"sacks-dawkins-science-religion-2012","number":"268","notice":"This assessment covers selected, self-contained Jonathan Sacks–Richard Dawkins exchanges within the main conversation, approximately 2:09–41:54. Substantive moderator interventions and their dependent replies are excluded, removing approximately 20:31 (51.6%) of that window and leaving approximately 19:14 of eligible conversation. The exclusions include host-led exchanges about book tone, selective evidence, divine intervention, religious upbringing, antisemitism, and moral necessity. Introductions and all audience Q&A are also unscored. Neither speaker receives credit or penalty for excluded material; the scores do not assess the complete event."},{"id":"craig-pigliucci-christian-god-2001","number":"271","notice":"This assessment covers both opening statements, both rounds of rebuttal, and both closing statements (approximately 6:31–1:39:05). The moderator’s subsequent third-position interlude and the entire audience Q&A, including both speakers’ answers, are excluded. Neither side receives credit or penalty for excluded material; these scores assess the approved formal debate, not the complete event."},{"id":"craig-dacey-god-existence-2004","number":"273","notice":"This assessment covers both opening statements, both rounds of rebuttal, and both closing statements (approximately 5:00–1:40:07). The entire audience Q&A, including both speakers’ answers and dependent replies, is excluded. Neither side receives credit or penalty for excluded material; these scores assess the approved formal debate, not the complete event."},{"id":"shermer-scrivener-good-without-god-2024","number":"277","notice":"By explicit editorial approval, this assessment scores only Michael Shermer and Glen Scrivener across the complete substantive exchange. Moderator Vince Vitale supplies substantive philosophical questions and challenges beyond the ordinary incidental-host allowance; his contributions remain context, and the debaters’ own replies remain eligible for assessment. No argument or score is assigned to a debater merely because Vitale advances it. Unequal questioning is considered when selecting moves and evaluating opportunities to respond. This is a recording-specific exception, not an assessment of a strictly two-speaker recording."},{"id":"lennox-tooley-atheism-christianity-2013","number":"278","notice":"The available recording ends after Michael Tooley’s closing remarks. A contemporary account also describes a closing statement by John Lennox, which is absent from the versions located. This assessment covers the available recording; neither speaker is penalized for material or replies missing from it."},{"id":"slick-barker-god-existence-2014","number":"279","notice":"This assessment uses the recoverable portions of the recording. A 33-second passage at the start of Matt Slick’s rebuttal (41:07.52–41:40.64) could not be reliably transcribed and is excluded. Neither speaker receives credit or a penalty for that passage, and no claim that an argument went unanswered relies on the missing material."},{"id":"turek-normark-god-existence-2014","number":"280","notice":"By explicit editorial approval, this assessment scores only Frank Turek and Dennis Nørmark across the substantive debate. Moderator Adam Holm contributes independent arguments and challenges, which remain context; the debaters’ own replies remain eligible for assessment. No moderator argument is credited to either debater. Unequal questioning is considered when selecting moves and evaluating opportunities to respond. This is a recording-specific exception to the ordinary two-speaker source rule."},{"id":"butt-barker-biblical-god-2009","number":"285","notice":"This assessment covers the formal opening statements, rebuttals, and cross-examination (approximately 5:54–1:08:57), plus both closing statements (1:46:09–1:57:06). The entire audience Q&A, including both speakers’ answers and dependent replies, is excluded at the editor’s request. Neither speaker receives credit or penalty for excluded material. These scores assess the formal rounds and closings, not the complete event."},{"id":"nesan-dillahunty-jesus-prophecy-2021","number":"286","notice":"This assessment covers the formal opening statements, rebuttals, cross-examination, and the speakers’ subsequent discussion before audience Q&A (approximately 0:12–1:02:31). This recording has no separate formal closing statements. The entire audience Q&A, including both speakers’ answers and dependent replies, plus the host’s after-show, is excluded at the editor’s request. Neither speaker receives credit or penalty for excluded material. These scores assess the debate portion, not the complete recording."},{"id":"johnson-barker-god-existence-2022","number":"287","notice":"This assessment covers both formal opening statements and rebuttals (approximately 10:28–1:03:56), plus both closing statements (1:22:28–1:30:03). The entire audience Q&A, including both speakers’ answers and dependent replies, and the hosts’ introductory and concluding discussion are excluded at the editor’s request. Neither speaker receives credit or penalty for excluded material. These scores assess the formal rounds and closings, not the complete recording."},{"id":"shermer-vandeweghe-jesus-miracles-2019","number":"288","notice":"This assessment covers both formal opening statements and rebuttals (approximately 6:56–1:11:59), plus both closing statements (1:49:07–1:58:23). The entire moderated discussion and audience Q&A, including both speakers’ answers and dependent replies, and the introductory montage and surrounding host remarks are excluded at the editor’s request. Neither speaker receives credit or penalty for excluded material. These scores assess the formal rounds and closings, not the complete recording."},{"id":"wielenberg-johnson-objective-morality-2020","number":"289","notice":"This assessment covers only the debaters’ direct exchange (approximately 33:05–1:13:25), as approved by the editor. The introductory position discussion, audience questions and all dependent answers, including the final reply to an audience question, are excluded. This recording has no separate formal opening speeches or paired closing statements. Neither speaker receives credit, penalties, or an inference of failing to reply from excluded material. These scores assess the direct exchange, not the complete recording."},{"id":"rauser-malpass-evidential-problem-evil-2021","number":"290","notice":"This assessment covers Alex Malpass’s opening and the debaters’ direct exchange (approximately 6:33–1:06:47), as approved by the editor. Host introductions and interruptions, audience questions and every dependent answer, and the host-only remainder are excluded. This recording has no paired formal rounds or closing speeches. Neither speaker receives credit, penalties, or an inference of failing to reply from excluded material. These scores assess the approved opening and exchange, not the complete recording."},{"id":"rauser-schieber-god-existence-2015","number":"291","notice":"This assessment covers the formal opening statements, rebuttals, scheduled cross-examination and both closing statements (approximately 2:10–1:27:00). Moderator introductions and logistics, the entire audience Q&A with every dependent answer and reply, and concluding host material are excluded at the editor’s request. Neither speaker receives credit, penalties, or an inference of failing to reply from excluded material. These scores assess the formal rounds, not the complete recording."},{"id":"thomason-clifton-morality-meaning-god-2020","number":"292","notice":"This was an informal conversation, with no formal opening rounds or closing speeches. At the editor’s request, this assessment covers only the direct philosophical exchanges at approximately 7:17–19:11, 22:27–36:37, and 1:02:32–1:15:37. Audience questions and all dependent answers and follow-ups, personal and political digressions, introductions and the outro are excluded. Neither speaker receives credit, penalties, or an inference of failing to reply from excluded material. These scores assess the selected exchanges, not the complete recording."},{"id":"mcdowell-paulogia-apostolic-martyrdom-2020","number":"293","notice":"This assessment covers Sean McDowell and Paulogia’s substantive discussion and final statements, approximately 8:43–1:11:15, with exclusions. Introductions, advertisements, moderator commentary and the host’s argumentative interventions and dependent replies are excluded, including the exchange at approximately 1:00:08–1:08:35. Neither speaker receives credit, penalties, or an inference of failing to reply from excluded material. There were no formal timed rounds or audience Q&A. The scores assess the retained discussion, not the complete recording."},{"id":"copan-rauser-canaanite-conquest-2022","number":"294","notice":"This assessment covers Paul Copan and Randal Rauser’s substantive discussion and final statements, approximately 4:31–1:25:19, with exclusions. Both speakers are Christians; the dispute concerns the moral defense and interpretation of the Canaanite conquest. Introductions, programme breaks, moderator commentary, and host arguments with dependent replies are excluded, including approximately 55:53–1:04:05 and 1:07:46–1:09:29. Neither speaker receives credit, penalties, or an inference of failing to reply from excluded material. There were no formal timed rounds or audience Q&A. The scores assess the retained discussion, not the complete recording."},{"id":"horn-paulogia-apostolic-sincerity-2023","number":"295","notice":"This assessment covers Trent Horn and Paulogia’s direct substantive exchange and concluding arguments, approximately 2:05–1:22:15. This was a dialogue, with no formal timed rounds, paired closing speeches or audience Q&A. Introductions, personal background, channel promotion and the outro are excluded. Neither speaker receives credit, penalties or an inference of failing to reply from excluded material. The question concerns the sincerity of the original resurrection witnesses; these scores do not determine whether the resurrection occurred."},{"id":"dillahunty-rauser-humanism-christianity-2023","number":"296","notice":"This assessment covers Matt Dillahunty and Randal Rauser’s opening speeches and direct debate, including the concluding exchange, approximately 0:22–1:09:31. Moderator logistics and promotional breaks are excluded. There are no paired formal closing speeches. Audience Q&A, its replies, the brief post-Q&A exchange and the host outro are excluded. Neither speaker receives credit, penalties or an inference of failing to reply from excluded material or the moderator’s final cutoff. The question concerns which framework is better for society; these scores do not determine whether Christianity is true."},{"id":"winger-paulogia-resurrection-evidence-2018","number":"297","notice":"This assessment covers Mike Winger and Paulogia’s November 1, 2018 opening arguments, direct exchange and both closing statements preserved in this edited upload, approximately 3:24–1:19:34. The later retrospective introduction, on-screen corrections, moderator logistics and outro are excluded. The upload omits audience Q&A and some procedural interjections; none is imported into the assessment. Neither speaker receives credit, penalties or an inference of failing to reply from excluded material. Automatic captions were checked against source audio around one short gap; uncertain selected passages receive separate verification. The scores assess the arguments presented, not whether the resurrection occurred."},{"id":"horn-lataster-god-existence-2016","number":"298","notice":"This assessment covers Trent Horn and Raphael Lataster’s opening speeches, both rebuttal rounds and cross-examination (approximately 4:06–1:10:46), plus both closing statements (1:40:19–1:48:30). Introductions, moderator logistics, audience Q&A and the outro are excluded. Neither speaker receives credit, penalties or an inference of failing to reply from excluded material. Automatic captions were checked against source audio for central wording and transitions; uncertain selected passages receive separate verification. Lataster’s grants of supernaturalism and monotheism are conditional concessions for discussion. The scores assess the arguments presented, not whether God exists."},{"id":"paulogia-jones-divine-hiddenness-2019","number":"299","notice":"By explicit editorial approval, this assessment scores only Paulogia and Michael Jones in the main discussion, approximately 7:58–58:46. Shannon Q contributes arguments and questions as context; the guests’ own replies remain eligible, but no moderator argument is credited to either guest. Unequal prompting is considered when evaluating their opportunities to respond. This is a discussion without formal timed rounds or paired closing speeches. Introductions, banter, the embedded audience exchange at approximately 49:44–53:28, the later audience Q&A and the outro are excluded. Neither guest receives credit, penalties or an inference of failing to reply from excluded material. Automatic captions were supplemented by targeted automated audio checks; this was not direct human listening."},{"id":"dennett-sapolsky-free-will-2023","number":"300","notice":"This assessment covers Daniel Dennett and Robert Sapolsky’s formal opening and reply rounds, approximately 2:24–42:43, including the brief direct exchange within the final reply round. There are no separate formal closing speeches. The introduction, moderator logistics, later moderated discussion, audience Q&A, final moderator question and replies, and polling are excluded. Neither speaker receives credit, penalties or an inference of failing to reply from excluded material. Automatic captions were supplemented by targeted automated audio checks; this was not direct human listening. Dennett accepts determinism, while Sapolsky accepts ordinary choosing and instrumental sanctions. Scores assess their arguments within this scope, not whether free will exists."},{"id":"wood-ally-resurrection-2018","number":"301","notice":"This assessment covers David Wood and Shabir Ally’s formal openings, both rebuttal rounds, cross-examination and both closing statements, approximately 21:14–2:15:57. Introductions, moderator logistics, audience Q&A and the final replies to audience questions are excluded. Neither speaker receives credit, penalties or an inference of failing to reply from excluded material. Automatic captions were supplemented by targeted automated audio checks, not direct human listening. Ally rejects substitution theory and distinguishes possible survival and ascension from resurrection after death. Scores assess the arguments presented within this scope, not the truth of either religion."},{"id":"rauser-barker-god-worthy-worship-2020","number":"302","notice":"By explicit editorial approval, this assessment scores only Randal Rauser and Dan Barker in the main discussion (approximately 1:52–1:28:28) and closing remarks (2:00:08–2:03:18). This is an informal discussion, not a debate with timed formal rounds. Cameron Bertuzzi contributes arguments as unscored context; only the debaters’ own contributions and replies receive assessment, and no moderator argument is credited to either side. Unequal prompting is considered when evaluating opportunities to respond. Introductions, audience Q&A and the outro are excluded, with no credit, penalty, inferred concession or failure-to-reply inference from that material. Rauser’s closing reference to an excluded audience exchange cannot support criticism of Barker’s assessed performance. Public automatic captions were supplemented by targeted automated audio checks; these were not direct human listening."},{"id":"craig-nugent-god-existence-2017","number":"303","notice":"This assessment covers William Lane Craig and Michael Nugent’s formal opening speeches, both rebuttal rounds and both closing statements, approximately 9:26–1:47:05. Introductions, moderator logistics, breaks and audience Q&A are excluded. Neither speaker receives credit, penalties or an inference of failing to reply from excluded material. Public automatic captions were supplemented by targeted automated audio checks; these were not direct human listening. Nugent affirms objective morality and allows that his atheistic belief may be mistaken. Scores assess the arguments presented within this scope, not whether theism or atheism is true."},{"id":"swinburne-ehrman-god-suffering-2009","number":"304","notice":"By explicit editorial approval, this assessment scores only Richard Swinburne and Bart Ehrman in their main exchange and both final summaries, approximately 25:05–1:18:44, excluding programme breaks. This radio debate has no timed formal rounds. Justin Brierley’s arguments and questions remain unscored context; only the two speakers’ own contributions and replies are assessed, and no host argument is credited to either side. Unequal prompting and opportunities to reply are considered. Introductions, listener material, the unrelated prerecorded segment, preliminary biographical interviews and the outro are excluded, with no credit, penalty, inferred concession or failure-to-reply inference from them. Swinburne answers the heaven objection in his final summary, after Ehrman’s last opportunity to respond. Public automatic captions were supplemented by five targeted automated audio checks, not direct human listening."},{"id":"mclatchie-paulogia-christianity-resurrection-2023","number":"305","notice":"This assessment covers both opening statements and the direct debate, approximately 2:26–1:36:18, plus both final argument summaries at 2:03:51–2:06:20. Audience Q&A, moderator logistics, banter, promotions and the outro are excluded; they supply no credit, penalty or inference of a failure to reply. The event asks whether resurrection was required: McLatchie explicitly argues for the best explanation rather than logical necessity, while Paulogia challenges necessity and comparative superiority and favors a natural explanation. Each is assessed on the position actually defended. Public automatic captions were supplemented by targeted automated audio checks; these were not direct human listening."},{"id":"meyer-atkins-intelligent-design-science-2010","number":"306","notice":"By explicit editorial approval, this assessment scores only Stephen Meyer and Peter Atkins in their substantive discussion and both closing remarks, approximately 04:47–1:01:33, excluding programme breaks. This radio discussion has no timed formal rounds and also includes recurring advocate Mark Haville. Haville and host Justin Brierley remain unscored context: their arguments and quoted material are not credited to either scored participant, but Meyer and Atkins’s own replies remain eligible. Unequal prompting and opportunities to respond are considered. Film excerpts, introductions, promotions, Haville’s final promotional remarks, listener feedback and the outro supply no credit, penalty, inferred concession or failure-to-reply inference. The source uses automatic captions and supplementary automated audio checks where available; no direct human listening is claimed."},{"id":"ehrman-white-bible-misquote-jesus-2009","number":"307","notice":"This assessment covers both formal openings, rebuttals, cross-examinations and closing statements, approximately 0:23–2:28:59. Audience Q&A, logistical interjections and the outro are excluded and supply no credit, penalty or inference of a failure to reply. Both speakers accept textual variants: Ehrman argues that important wording changed and some originals remain uncertain; White defends reliable recovery and continuity of the New Testament’s message. Each is assessed on the position actually defended. Public automatic captions were supplemented by five targeted automated audio checks; these were not direct human listening."},{"id":"schieber-rauser-religious-disagreement-2017","number":"308","notice":"By explicit editorial approval, this assessment scores only Justin Schieber and Randal Rauser’s discussion and concluding replies, approximately 12:41–1:00:59, excluding programme breaks. Host Justin Brierley contributes arguments and questions as unscored context; each guest’s own replies remain eligible, but no host argument is credited to either guest. Unequal prompting is considered when evaluating opportunities to respond. This is a moderated discussion without timed formal rounds or paired formal closing speeches. Introductions, book promotion and the outro are excluded and supply no credit, penalty or inference of a failure to reply. The source is the complete public automatic-caption track; no direct human listening or auxiliary audio transcription is claimed."}],"year":"2017","videoId":"G_jSS5Z4oFU","modelLabel":"5.6 Sol","tagCount":8,"people":[{"name":"Justin Schieber","slug":"justin-schieber"},{"name":"Randal Rauser","slug":"randal-rauser"}],"graph":{"sectionSideScores":3408,"minimum":48,"maximum":95,"buckets":[{"range":"48–49","count":1},{"range":"50–51","count":1},{"range":"52–53","count":1},{"range":"54–55","count":1},{"range":"56–57","count":3},{"range":"58–59","count":9},{"range":"60–61","count":10},{"range":"62–63","count":14},{"range":"64–65","count":37},{"range":"66–67","count":54},{"range":"68–69","count":80},{"range":"70–71","count":142},{"range":"72–73","count":193},{"range":"74–75","count":203},{"range":"76–77","count":300},{"range":"78–79","count":368},{"range":"80–81","count":415},{"range":"82–83","count":433},{"range":"84–85","count":370},{"range":"86–87","count":321},{"range":"88–89","count":249},{"range":"90–91","count":149},{"range":"92–93","count":42},{"range":"94–95","count":12}],"debateNumber":"308","contribution":[84,76,86,76,85,79,84,79,88,79],"publishedDebates":308,"eachDebateMatched":true,"noScoreCalculation":true}};
const staticReplay=async function replayStaticScope(page,cfg) {
  const observations=[],screenshots=[];
  for(const viewport of [{width:1440,height:1000},{width:390,height:844}]) {
    const context=await page.context().browser().newContext({javaScriptEnabled:false,viewport});
    try {
      const p=await context.newPage();
      for(const item of cfg.scopeCases) {
        const response=await p.goto(cfg.origin+'/debate/'+item.id+'/');
        if(response.status()!==200)throw Error('Static HTTP failure '+item.id);
        const notice=p.locator('.seo-fallback > .source-context');await notice.waitFor({state:'visible'});
        if((await notice.locator('span').innerText()).trim()!==item.notice)throw Error('Static notice mismatch '+item.id);
        const nb=await notice.boundingBox(),sb=await p.locator('.seo-fallback > p:not(.eyebrow)').first().boundingBox();
        if(!nb||!sb||nb.y+nb.height>sb.y+1)throw Error('Static scope must precede scores '+item.id);
        const width=await p.evaluate(()=>({viewport:innerWidth,document:document.documentElement.scrollWidth}));
        if(width.document>width.viewport+1)throw Error('Static overflow '+item.id);
        observations.push({debateNumber:item.number,viewport,noticeBeforeScores:true,noticeExact:true});
        if(item.id===cfg.candidate.id && cfg.screenshots!==false) {
          const file=cfg.screenshotDirectory+'/'+cfg.prefix+'-static-'+viewport.width+'.png';await p.screenshot({path:file});screenshots.push(file);
        }
      }
    } finally {await context.close();}
  }
  return {status:'passed-static-source-scope',observations,screenshots};
};
const interactiveReplay=async function replayPublication(page, cfg) {
  const d = cfg.candidate;
  const fail = (message) => { throw new Error(message); };
  const same = (a,b,label) => { if(JSON.stringify(a)!==JSON.stringify(b))fail(label+': '+JSON.stringify({actual:a,expected:b})); };
  const ok = (value,label) => { if(!value)fail(label); };
  const errors=[],resources=[],observations=[],screenshots=[];
  page.on('pageerror',e=>errors.push(String(e)));
  page.on('console',e=>{if(e.type()==='error')errors.push(e.text());});
  page.on('requestfailed',r=>resources.push({url:r.url(),failure:r.failure()}));
  page.on('response',r=>{if(r.status()>=400)resources.push({url:r.url(),status:r.status()});});
  const route='/debate/'+d.id+'/';
  const go=async path=>{const response=await page.goto(cfg.origin+path);ok(response.status()===200,'route status '+path);await page.waitForLoadState('networkidle');};
  const shot=async name=>{if(cfg.screenshots===false)return;const path=cfg.screenshotDirectory+'/'+cfg.prefix+'-'+name+'.png';await page.screenshot({path});screenshots.push(path);};
  const overflow=async label=>{await page.waitForLoadState('networkidle');const value=await page.evaluate(()=>({viewport:innerWidth,width:document.documentElement.scrollWidth,broken:[...document.images].filter(i=>i.complete&&i.naturalWidth===0).map(i=>i.src)}));ok(value.width<=value.viewport+1,label+' horizontal overflow');same(value.broken,[],label+' broken images');return value;};
  const visible=async locator=>{await locator.waitFor({state:'visible'});await page.waitForFunction(el=>{const s=getComputedStyle(el);return s.visibility!=='hidden'&&Number(s.opacity)>0.95;},await locator.elementHandle());};
  const expectedSections=d.sections.map(s=>({title:s.title,scores:[s.score.pro,s.score.con],cards:s.exchanges.flatMap(e=>['pro','con'].filter(k=>e[k]).map(k=>({side:k,words:e[k].words,critique:e[k].critique,time:e[k].time,score:e[k].score,role:e[k].role,tags:e[k].tags.map(t=>({label:t.label,context:t.context}))})))}));
  for(const viewport of [{width:1440,height:1000},{width:390,height:844}]){
    const name=viewport.width===1440?'desktop':'mobile';await page.setViewportSize(viewport);await go(route);await page.locator('.debate-section').first().waitFor();
    const observed=await page.evaluate(()=>({
      title:[...document.querySelector('h1').childNodes].filter(n=>n.nodeType===Node.TEXT_NODE).map(n=>n.textContent).join('').trim(),
      year:document.querySelector('.debate-title-year')?.textContent || '',
      body:document.querySelector('main').innerText,
      source:document.querySelector('a[href^="https://www.youtube.com/watch"]').getAttribute('href'),
      sections:[...document.querySelectorAll('.debate-section')].map(s=>({title:s.querySelector('h2').textContent.trim(),scores:[...s.querySelectorAll('.section-score strong')].map(e=>Number(e.textContent)),cards:[...s.querySelectorAll('.argument')].map(c=>({side:c.classList.contains('side-pro')?'pro':'con',words:c.querySelector(':scope > p').textContent.trim(),critique:c.querySelector('.critique-text').textContent.trim().replace(/\s+/g,' '),time:c.querySelector('.timestamp-link').textContent.trim(),score:Number(c.querySelector('.argument-meta strong').textContent),role:c.querySelector('.argument-meta > span:nth-child(2)').textContent.trim(),tags:[...c.querySelectorAll('.tag-wrap')].map(t=>({label:t.querySelector('a.tag').textContent.trim(),context:t.querySelector('.tag-context').textContent.trim()}))}))})),
      overall:[...document.querySelectorAll('.overall-score strong')].map(x=>Number(x.textContent)),
      quotes:[...document.querySelectorAll('.quote-card blockquote')].map(x=>x.textContent.trim()),
      timestampLinks:[...document.querySelectorAll('.argument .timestamp-link')].map(a=>({text:a.textContent.trim(),href:a.href})),
      ai:[...document.querySelectorAll('.logical-extension-side')].map(e=>({finalArgument:{thesis:e.querySelector('.extension-thesis').textContent.trim(),premises:[...e.querySelectorAll('.extension-premises li p')].map(p=>p.textContent.trim()),conclusion:e.querySelector('.extension-conclusion p').textContent.trim()},newArguments:[...e.querySelectorAll('.new-argument')].map(a=>({title:a.querySelector('h5').textContent.trim(),text:a.querySelector('p').textContent.trim()}))}))
    }));
    same(observed.title,d.title.replace(/\s*\(\d{4}\)\s*$/,''),'title');same(observed.year,String(cfg.year),'year');same(observed.sections,expectedSections,'all section and argument text');same(observed.overall,[d.overall.pro.score,d.overall.con.score],'overall scores');same(observed.quotes,['pro','con'].map(s=>'"'+d.quotes[s].text+'"'),'exact quotes');same(observed.ai,[d.logicalExtension.pro,d.logicalExtension.con],'complete AI text');same(observed.source,d.youtubeUrl,'source');
    for(const s of ['pro','con']){ok(observed.body.includes(d.sides[s].speaker),'speaker');ok(observed.body.includes(d.sides[s].name),'position');}ok(observed.body.includes(d.motion),'motion');if(cfg.requiredReaderDisclosure)ok(observed.body.includes(cfg.requiredReaderDisclosure),'complete authorized source scope disclosure');ok(observed.body.includes(cfg.modelLabel),'assessment byline');
    for(const a of observed.timestampLinks){const parts=a.text.split(':').map(Number);const seconds=parts.reduce((n,x)=>n*60+x,0);const u=new URL(a.href);same(u.searchParams.get('v'),cfg.videoId,'timestamp video');same(u.searchParams.get('t'),seconds+'s','timestamp offset');}
    const renderedLabels=await page.locator('.argument .critique-text').evaluateAll(els=>els.map(e=>[...e.querySelectorAll('.critique-section > strong')].map(s=>s.textContent)));same(renderedLabels,expectedSections.flatMap(s=>s.cards.map(()=>['Strongest feature:','Principal limitation:','Live burden:','Locked score:'])),'four independently rendered bold critique labels');
    let scopeEvidence=null;
    if(cfg.requiredReaderDisclosure){const disclosure=page.locator('.source-context');await visible(disclosure);same((await disclosure.locator('span').innerText()).trim(),cfg.requiredReaderDisclosure,'verbatim visible scope disclosure');
    const scopeBox=await disclosure.boundingBox(),firstScoreBox=await page.locator('.scoreboard').first().boundingBox();ok(scopeBox&&firstScoreBox&&scopeBox.y+scopeBox.height<=firstScoreBox.y+2,'scope disclosure before top score summary');
    scopeEvidence={text:(await disclosure.innerText()),box:scopeBox,firstScoreBox,beforeScores:true};
    }
    const size=await overflow(name);await shot(name+'-header');if(cfg.requiredReaderDisclosure){await page.locator('.source-context').scrollIntoViewIfNeeded();await shot(name+'-source-scope');}
    const critique=page.locator('.critique button').first(),popover=page.locator('.critique-popover').first();await critique.hover();await visible(popover);await critique.focus();await critique.press('Enter');await visible(popover);await critique.press('Space');await visible(popover);await shot(name+'-critique');
    const summary=page.locator('.ai-extension-accordion > summary');await summary.click();same(await page.locator('.ai-extension-accordion').getAttribute('open'),'','immediate distant control after critique');await visible(page.locator('.logical-extension-grid'));await summary.focus();await summary.press('Enter');same(await page.locator('.ai-extension-accordion').getAttribute('open'),null,'Enter collapse');await summary.press('Space');same(await page.locator('.ai-extension-accordion').getAttribute('open'),'','Space expand');
    // A fresh navigation removes the focused critique for unobscured visual evidence.
    await go(route);await summary.scrollIntoViewIfNeeded();await shot(name+'-ai-closed');await summary.click();await page.locator('.logical-extension').evaluate(e=>window.scrollTo(0,e.getBoundingClientRect().top+scrollY-220));await shot(name+'-ai-open');await page.locator('.new-arguments').first().evaluate(e=>window.scrollTo(0,e.getBoundingClientRect().top+scrollY-220));await shot(name+'-reinforcements');await overflow(name+' AI open');
    const tags=page.locator('a.tag');const count=await tags.count();same(count,cfg.tagCount,'all accepted tags rendered');
    if(count){await go(route);const tag=page.locator('a.tag').first();const wrap=page.locator('.tag-wrap').first();await tag.hover();await tag.focus();await visible(wrap.locator('.tag-popover'));await shot(name+'-tag');const href=await tag.getAttribute('href');await tag.press('Enter');await page.waitForURL(cfg.origin+href);await page.locator('[id="'+decodeURIComponent(new URL(cfg.origin+href).hash.slice(1))+'"]').waitFor();await page.waitForFunction(([pro,con])=>{const text=document.querySelector('main')?.innerText||'';return text.includes(pro)||text.includes(con);},[d.sides.pro.speaker,d.sides.con.speaker]);ok((await page.locator('main').innerText()).includes(d.sides.pro.speaker)|| (await page.locator('main').innerText()).includes(d.sides.con.speaker),'tag reference occurrence');}
    await go('/backend/');await page.locator('.section-score-bucket').first().waitFor();const graph=await page.evaluate(()=>({summary:Object.fromEntries([...document.querySelectorAll('.section-score-distribution-summary > div')].map(x=>[x.querySelector('dt').textContent.trim(),x.querySelector('dd').textContent.trim()])),buckets:[...document.querySelectorAll('.section-score-bucket')].map(x=>({range:x.querySelector('strong').textContent.trim(),count:Number(x.querySelector('.section-score-bar-column > span').textContent),aria:x.getAttribute('aria-label')}))}));
    same(Number(graph.summary['Section-side scores'].replaceAll(',','')),cfg.graph.sectionSideScores,'graph total');same(graph.summary['Observed range'],cfg.graph.minimum+'–'+cfg.graph.maximum,'graph range');same(graph.buckets.map(({range,count})=>({range,count})),cfg.graph.buckets,'every graph bucket');for(const b of graph.buckets)same(b.aria,`${b.range} percent: ${b.count} section-side score${b.count===1?'':'s'}`,'graph accessible count');await page.locator('#rubric-quality-check').scrollIntoViewIfNeeded();await shot(name+'-backend');await overflow(name+' backend');
    const profiles=[];for(const person of cfg.people){await go('/interlocutor/'+person.slug+'/');await page.locator('.profile-bio-chart').waitFor();const bio=page.locator('.profile-biography').first(),chart=page.locator('.profile-bio-chart .profile-score-histogram');const bb=await bio.boundingBox(),cb=await chart.boundingBox();ok(bb&&cb,'profile biography and graph');if(name==='desktop')ok(bb.x+bb.width<=cb.x+2,'bio left of graph');else ok(bb.y+bb.height<=cb.y+2,'bio above graph');ok(await page.locator('a[href="'+route+'"]').count()>0,'profile debate presence');await page.locator('.profile-bio-chart').scrollIntoViewIfNeeded();await shot(name+'-'+person.slug+'-profile');await overflow(name+' profile');profiles.push({name:person.name,bio:bb,chart:cb});}
    observations.push({viewport,size,scopeDisclosure:scopeEvidence,sections:observed.sections.length,cards:observed.sections.reduce((n,s)=>n+s.cards.length,0),exactPublicationText:true,exactAiText:true,exactTimestampLinks:true,acceptedTags:count,critiquePointerEnterSpace:true,accordionPointerEnterSpace:true,immediateDistantControlAfterCritique:true,graph,profiles});
  }
  await page.setViewportSize({width:1440,height:1000});const routes=[];
  for(const path of ['/','/topics/'+d.topicCategory+'/']){await go(path);await page.locator('a[href="'+route+'"]').first().waitFor();routes.push(path);}
  await go('/search/');const search=page.locator('input[type="search"]');await search.fill(d.sides.con.speaker);await search.press('Enter');await page.waitForLoadState('networkidle');
  const searchedPages=new Set();
  while(await page.locator('a[href="'+route+'"]').count()===0){
    ok(!searchedPages.has(page.url()),'search pagination cycle');searchedPages.add(page.url());
    const next=page.getByRole('link',{name:'Next',exact:true}).first();ok(await next.count()>0,'debate absent from search results');
    const href=await next.getAttribute('href');ok(href?.startsWith('/search/?'),'search pagination route');await go(href);
  }
  await page.locator('a[href="'+route+'"]').first().waitFor();await shot('search');routes.push('/search/');
  await go('/rankings/?'+new URLSearchParams({'compare-a':cfg.people[0].name,'compare-b':cfg.people[1].name}));for(const person of cfg.people)await page.locator('a[href="/interlocutor/'+person.slug+'/"]').first().waitFor();await shot('rankings');routes.push('/rankings/');
  const sitemap=await page.request.get(cfg.origin+'/sitemap.xml');same(sitemap.status(),200,'sitemap status');ok((await sitemap.text()).includes('https://slugfester.com'+route),'canonical sitemap');
  same(errors,[],'browser runtime errors');same(resources,[],'failed resources');
  return {status:'passed-exact-publication-browser-replay',debateNumber:d.number,debateId:d.id,origin:cfg.origin,observations,routes,sitemap:true,errors,resources,screenshots};
};
return {static:await staticReplay(page,cfg),interactive:await interactiveReplay(page,cfg)};
}
)(page);
