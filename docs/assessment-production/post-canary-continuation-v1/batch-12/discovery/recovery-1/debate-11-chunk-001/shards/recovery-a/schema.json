{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "slugfester-batch-12-debate-11-chunk-001-recovery-a",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolId",
    "debateNumber",
    "debateId",
    "chunkId",
    "coreStartEvent",
    "coreEndEvent",
    "contextStartEvent",
    "contextEndEvent",
    "reviewerRole",
    "assessmentModel",
    "calibrationOnly",
    "completeCoreReviewed",
    "candidates"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0-score-stability-v2.1.2-score-blind-chunk-discovery"
    },
    "protocolId": {
      "type": "string",
      "const": "assessment-production-score-stability-v2.1.2-bounded-end-discovery"
    },
    "debateNumber": {
      "type": "string",
      "const": "11"
    },
    "debateId": {
      "type": "string",
      "const": "dsouza-ehrman-god-suffering-evil-2025"
    },
    "chunkId": {
      "type": "string",
      "const": "chunk-001"
    },
    "coreStartEvent": {
      "type": "integer",
      "const": 0
    },
    "coreEndEvent": {
      "type": "integer",
      "const": 429
    },
    "contextStartEvent": {
      "type": "integer",
      "const": 0
    },
    "contextEndEvent": {
      "type": "integer",
      "const": 469
    },
    "reviewerRole": {
      "type": "string",
      "const": "score-blind-source-discovery"
    },
    "assessmentModel": {
      "type": "string",
      "const": "5.6 Sol"
    },
    "calibrationOnly": {
      "type": "boolean",
      "const": true
    },
    "completeCoreReviewed": {
      "type": "boolean",
      "const": true
    },
    "candidates": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidateId",
          "side",
          "speaker",
          "proposition",
          "sourceWindow",
          "attributionConfidence",
          "attributionBasis",
          "loadBearingLevel",
          "loadBearingReason",
          "responseIntent",
          "contextSummary",
          "candidateConfidence"
        ],
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^recovery-a-[A-Za-z0-9._:-]+$"
          },
          "side": {
            "type": "string",
            "enum": [
              "pro",
              "con"
            ]
          },
          "speaker": {
            "type": "string",
            "enum": [
              "Dinesh D'Souza",
              "Bart Ehrman"
            ]
          },
          "proposition": {
            "type": "string",
            "minLength": 25
          },
          "sourceWindow": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startEvent",
              "endEvent"
            ],
            "properties": {
              "startEvent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 429
              },
              "endEvent": {
                "type": "integer",
                "minimum": 0,
                "maximum": 469
              }
            }
          },
          "attributionConfidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "attributionBasis": {
            "type": "string",
            "minLength": 40
          },
          "loadBearingLevel": {
            "type": "string",
            "enum": [
              "motion",
              "central",
              "subsidiary"
            ]
          },
          "loadBearingReason": {
            "type": "string",
            "minLength": 60
          },
          "responseIntent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "earlierTargetDescription"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "constructive",
                  "reply"
                ]
              },
              "earlierTargetDescription": {
                "type": "string"
              }
            }
          },
          "contextSummary": {
            "type": "string",
            "minLength": 60
          },
          "candidateConfidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    }
  }
}
