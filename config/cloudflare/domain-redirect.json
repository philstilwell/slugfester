{
  "phase": "http_request_dynamic_redirect",
  "rules": [
    {
      "description": "Redirect www to Slugfester canonical domain",
      "expression": "(http.host eq \"www.slugfester.com\")",
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "status_code": 301,
          "target_url": {
            "expression": "concat(\"https://slugfester.com\", http.request.uri.path)"
          },
          "preserve_query_string": true
        }
      },
      "enabled": true
    }
  ]
}
